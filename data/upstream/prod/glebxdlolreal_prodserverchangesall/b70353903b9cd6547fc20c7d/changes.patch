+}
+
+.skeleton-hero .skeleton-line {
+  margin-top: var(--space-12);
+}
+
+.skeleton-cell {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-height: var(--cell-min);
+  padding: var(--space-12) var(--space-16);
