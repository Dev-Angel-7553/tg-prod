+  --button: var(--tg-theme-button-color, var(--fb-button));
+  --button-text: var(--tg-theme-button-text-color, var(--fb-button-text));
+  --destructive: var(--tg-theme-destructive-text-color, var(--fb-destructive));
+  /* Red text: the theme's destructive colour a step towards the text, as iOS's #ff3b30 is 3.6:1 on white and its
+     dark #eb5545 3.9:1 on a dark island. Glyphs and fills keep --destructive. */
+  --destructive-ink: color-mix(in srgb, var(--destructive) 70%, var(--text));
+  /* Section headers are secondary text: iOS's #6d6d72 is 4.49:1 on #efeff4. */
+  --section-header: var(--secondary-text);
+  --separator: var(--tg-theme-section-separator-color, var(--fb-separator));
+
+  /* Neutral overlays that read on light and dark sections alike. */
+  --pressed: rgba(127, 127, 127, 0.2);
+  --hover: rgba(127, 127, 127, 0.1);
+  --fill: rgba(118, 118, 128, 0.12);
+  --thumb: #ffffff;
+  --toast: rgba(30, 30, 32, 0.92);
+  --success: #34c759;
+  --warning: #ff9500;
+
+  /* Spacing: the 4 px grid and nothing else (design §11.3). */
+  --space-4: 4px;
+  --space-8: 8px;
+  --space-12: 12px;
+  --space-16: 16px;
+  --space-24: 24px;
+  --space-32: 32px;
+  --space-40: 40px;
+  --space-48: 48px;
+  --space-64: 64px;
+
+  /* The hero gradient, PremiumUI/Sources/IncreaseLimitHeaderItem.swift. The hero mark and its glow use it; tier 3 of
+     the ladder below is the one other place gradients live (design §11.5). */
+  --brand-1: #6b93ff;
+  --brand-2: #976fff;
+  --brand-3: #e46ace;
+  --brand-gradient: linear-gradient(90deg, var(--brand-1), var(--brand-2), var(--brand-3));
+  /* Premium's light (design.md §11.9): one family from indigo to magenta, in both themes. Best Value's ring
+     is its bright form and its tab the deep one, every stop of which carries its 12 px white label at 7:1 or better. */
+  --premium-from: #5c48ff;
+  --premium-to: #e03fc6;
+  --premium-ring: linear-gradient(90deg, #5d5cff, #8f4dff, #e64fc8);
+  --premium-tab: linear-gradient(90deg, #3f34cc, #6436ca, #923083);
+
+  /* One accent hue per screen (design §11.1): violet on Premium, gold on Stars, the theme's accent on giveaways; on
+     Stars the gold stays in the art and the controls take the theme. Badges are the ink
+     on its 12% tint. Stars gold: TelegramUI/Components/Stars/StarsPurchaseScreen/Sources/StarsPurchaseScreen.swift
+     line 805. Blue-violet is ramp 20, the violet's blue neighbour, behind the boost and giveaway animations'
+     stand-ins. */
+  --violet: #7356f6;
+  --violet-tint: rgba(115, 86, 246, 0.12);
+  --stars-gold: #f9b004;
+  --gold-tint: rgba(249, 176, 4, 0.12);
+  --blue-violet: #5b79ff;
+  /* The tier ladder of plan_emphasis graded (design §11.5): Best Value is tier 3, the other options step down from it
+     by saving along Telegram's Premium spectrum (the --ramp-* tiles below). Tier 1 is its blue (ramp 23), tier 2 the
+     violet, tier 3 its magentas (ramps 11 to 9), in light and dark. The deep gradient's blue, ramp 22 and Telegram's
+     Premium gift ribbon (#747bf6 → #e367d8) read as the violet at a glance on a small pill. */
+  --tier-1: #429bd5;
+  --tier-1-tint: rgba(66, 155, 213, 0.12);
+  --tier-2: var(--violet);
+  --tier-2-ink: var(--violet-pill-ink, var(--violet-ink));
+  --tier-2-tint: var(--violet-tint);
+  /* Deep enough for the pill's small white label to hold 7:1 on every stop. */
+  --tier-3: linear-gradient(90deg, #823895, #8f3371);
+  --tier-3-tint: linear-gradient(90deg, rgb(171 74 196 / 0.12), rgb(188 67 149 / 0.12));
+  --tone: var(--violet);
+  --tone-ink: var(--violet-ink);
+  --tone-tint: var(--violet-tint);
+  /* The MainButton's fill under white text at 4.5:1. */
+  --tone-solid: var(--violet);
+  /* Fills that carry a white glyph (radio checks): the theme accent, or the tone on a toned screen. */
+  --accent-fill: var(--accent);
+  /* Best Value's ring and tab carry two gradients and no more: the 2 px ring in the bright
+     one and the tab in the deep one under --best-on-fill. Per tone below. Its tier 3 fills are the magenta one. */
+  --best-border: var(--premium-ring);
+  --best-ring: 2px;
+  --best-fill: var(--premium-tab);
+  --best-on-fill: #fff;
+  /* The light's two colours (design.md §11.9), the tone's by default; Best Value's runs to the end of its ring's. */
+  --glow-from: var(--premium-from);
+  --glow-to: var(--premium-to);
+  --best-glow-to: #e64fc8;
+  /* The page's top colour, lit by the tone, where a screen opens on its stage: the header takes it (src/fx/stage.ts),
+     and in fullscreen it runs up under the status bar. A screen without a stage starts on --page. */
+  --page-top: color-mix(in srgb, var(--glow-from) var(--page-top-a), var(--page-top-base));
+
+  /* Icon tiles in Telegram's own colour per function, diagonal from the bottom left (PresentationResourcesSettings
+     .swift: premium, stars, premiumGift, support, faq, security). Native tiles are outside the one-accent rule. */
+  --tile-premium: linear-gradient(45deg, #6b93ff 15%, #8d77ff 50%, #b56eec 85%);
+  --tile-stars: linear-gradient(45deg, #fec80f, #dd6f12);
+  --tile-gift: linear-gradient(45deg, #3ba1f2 15%, #39b3b4 50%, #34c27d 85%);
+  --tile-support: #ff9f0a;
+  --tile-faq: #32ade6;
+  --tile-gray: #8e8e93;
+
+  /* Feature tiles: PremiumUI/Sources/PremiumIntroScreen.swift lines 1977–2002, in list order. */
+  --ramp-1: #ef6922;
+  --ramp-2: #e95a2c;
+  --ramp-3: #e74e33;
+  --ramp-4: #e74e33;
+  --ramp-5: #e54937;
+  --ramp-6: #e3433c;
+  --ramp-7: #db374b;
+  --ramp-8: #cb3e6d;
+  --ramp-9: #bc4395;
+  --ramp-10: #bc4395;
+  --ramp-11: #ab4ac4;
+  --ramp-12: #ab4ac4;
+  --ramp-13: #a34cd7;
+  --ramp-14: #9b4fed;
+  --ramp-15: #8958ff;
+  --ramp-16: #8958ff;
+  --ramp-17: #676bff;
+  --ramp-18: #676bff;
+  --ramp-19: #6172ff;
+  --ramp-20: #5b79ff;
+  --ramp-21: #5b79ff;
+  --ramp-22: #4492ff;
+  --ramp-23: #429bd5;
+  --ramp-24: #41a6a5;
+  --ramp-25: #3eb26d;
+  --ramp-26: #3dbd4a;
+
+  /* Shape and layout (design §11.3). Islands (§11.7): every section and card is a raised surface, radius 20 on iOS
+     and 16 elsewhere, on the section colour one step lighter than the page. */
+  --column: 560px;
+  --gutter: 16px;
+  --island-radius: 20px;
+  --island-surface: var(--section);
+  --surface-shadow: var(--island-shadow);
+  --section-radius: var(--island-radius);
+  --card-radius: var(--island-radius);
+  --section-gap: var(--space-32);
+  --section-inset: 16px;
+  /* A tile is a 30 px face (PresentationResourcesSettings.swift) drawn in a 32 px box that keeps the 4 px grid. */
+  --tile: 30px;
+  --tile-box: 32px;
+  --tile-radius: 8px;
+  --badge-radius: 6px;
+  --avatar: 40px;
+
+  /* Type, iOS, on a 17 px root. Each line height is the target px over the font px, so it scales with Dynamic Type;
+     the extra 0.005 px keeps layout's 1/64 px rounding from dropping a line below its target. Lines sit on the 4 px
+     grid, at 13 px and below on 2 px steps. System fonts only: SF Pro picks its Text or Display cut by size,
+     ui-rounded is SF Pro Rounded. Tracking stays the system's own. */
+  --font: -apple-system, system-ui, sans-serif;
+  --font-display: var(--font);
+  --font-rounded: ui-rounded, -apple-system, system-ui, sans-serif;
+  --fw-title: 700;
+  --fw-strong: 600;
+  --fw-medium: 500;
+  --fw-tab: var(--fw-strong);
+  --fw-badge: var(--fw-strong);
+  --fw-num: var(--fw-strong);
+  --fs-hero: calc(28rem / 17);
+  --lh-hero: calc(32.005 / 28);
+  --fs-title: calc(22rem / 17);
+  --lh-title: calc(28.005 / 22);
+  --fs-body: 1rem;
+  --lh-body: calc(20.005 / 17);
+  --lh-body-wrap: calc(22.005 / 17);
+  /* Subhead: hero subtitles and tile labels. */
+  --fs-sub: calc(15rem / 17);
+  --lh-sub: calc(20.005 / 15);
+  /* Footnote: cell subtitles, per-month lines, savings, footers; -wrap where it runs to more lines. */
+  --fs-small: calc(13rem / 17);
+  --lh-small: calc(16.005 / 13);
+  --lh-small-wrap: calc(18.005 / 13);
+  /* Captions in artwork (the limits chart). */
+  --fs-caption: calc(13rem / 17);
+  --lh-caption: calc(16.005 / 13);
+  /* Pills (badges): rounded numerals on a 20 px line, which is the pill's height. The Best Value tab: 12/16. */
+  --fs-badge: calc(13rem / 17);
+  --lh-pill: calc(20.005 / 13);
+  --font-badge: var(--font-rounded);
+  --fs-tab: calc(12rem / 17);
+  --lh-tab: calc(16.005 / 12);
+  /* Segmented control labels, SegmentedControlNode.swift: 14 px, centred in their 28 px thumb. */
+  --fs-segment: calc(14rem / 17);
+  --lh-segment: calc(18.005 / 14);
+  /* Numerals: the Stars balance (XL) and the gift months (L). */
+  --fs-big: calc(48rem / 17);
+  --lh-big: calc(56.005 / 48);
+  --fs-num-l: calc(28rem / 17);
+  --lh-num-l: calc(32.005 / 28);
+  --fs-section-header: var(--fs-small);
+  --lh-section-header: var(--lh-small);
+  --fw-section-header: 400;
+  --cell-min: calc(44rem / 17);
+  --motion-fade: 120ms;
+}
+
+.tone-premium {
+  --tone: var(--violet);
+  --tone-ink: var(--violet-ink);
+  --tone-tint: var(--violet-tint);
+  --tone-solid: var(--violet);
+  --best-border: var(--premium-ring);
+  --best-fill: var(--premium-tab);
+  --best-on-fill: #fff;
+  --glow-from: var(--premium-from);
+  --glow-to: var(--premium-to);
+  --best-glow-to: #e64fc8;
+}
+
+.tone-stars {
+  --tone: var(--stars-gold);
+  /* Gold lives in the art, the clusters and the Popular ring; text and controls take the theme, as Telegram's Stars
+     screens do (StarsBalanceComponent.swift fills its buttons with the theme accent). */
+  /* The theme's accent a step towards the text: Telegram's own accents fall to 2.9:1 (Android #1c93e3) and 3.5:1
+     (iOS #0088ff) as text. */
+  --tone-ink: color-mix(in srgb, var(--tg-theme-accent-text-color, var(--tg-theme-link-color, var(--fb-link))) 70%, var(--text));
+  --tone-tint: color-mix(in srgb, var(--tone-ink) 12%, transparent);
+  --tone-solid: var(--button);
+  /* The popular pack: a 1.5 px gold ring and the gold tab under deep ink. */
+  --best-border: linear-gradient(90deg, #fec846, #ec920a);
+  --best-ring: 1.5px;
+  --best-fill: linear-gradient(90deg, #fec846, #ec920a);
+  --best-on-fill: #2e1d00;
+  --glow-from: #fec846;
+  --glow-to: #ec920a;
+  --best-glow-to: #ec920a;
+  /* Gold reads as cream in light: beside the mark it pools as cream. */
+  --pool-a: 12%;
+}
+
+.tone-giveaway {
+  /* The Stars rule: row text, glyphs, radios, checks and the CTA take the theme, the hero art keeps its own hue
+     (fx palette). CTAs in the theme's button colour. */
+  --tone: var(--tone-ink);
+  /* The theme's accent a step towards the text: Telegram's own accents fall to 2.9:1 (Android #1c93e3) and 3.5:1
+     (iOS #0088ff) as text. */
+  --tone-ink: color-mix(in srgb, var(--tg-theme-accent-text-color, var(--tg-theme-link-color, var(--fb-link))) 70%, var(--text));
+  --tone-tint: color-mix(in srgb, var(--tone-ink) 12%, transparent);
+  --tone-solid: var(--button);
+  /* The blue half of the hero gradient and of its deep form, no magenta. */
+  --best-border: linear-gradient(90deg, #6b93ff, #976fff);
+  --best-fill: linear-gradient(90deg, #4466ee, #7356f6);
+  --best-on-fill: #fff;
+  --glow-from: #6b93ff;
+  --glow-to: #976fff;
+  --best-glow-to: #976fff;
+}
+
+/* A toned screen has one accent hue: links, actions and checks take it too. Its page top takes its light. */
+.tone-premium,
+.tone-stars,
+.tone-giveaway {
+  --accent: var(--tone-ink);
+  --link: var(--tone-ink);
+  --accent-fill: var(--tone);
+  --page-top: color-mix(in srgb, var(--glow-from) var(--page-top-a), var(--page-top-base));
+}
+
+.tone-stars,
+.tone-giveaway {
+  --accent-fill: var(--button);
+}
+
+/* Stars and giveaways light the page by their sources in both themes: no wash over the stage and an unlit top. A
+   faint wide gold turns brown on dark, so the gold of the stage stays in the hero, the rims and the Popular aura. */
+.tone-stars,
+.tone-giveaway {
+  --pool-top: 0%;
+  --page-top-a: 0%;
+}
+
+/* Their fireflies carry the tone's own light down the page: Stars gold to amber, giveaways blue to violet.
+   In light they are pastels a hair under the page; in dark, light added to bg_color, about the islands' luminance on
+   black, so on any host they light the page. */
+.tone-stars {
+  --fly-from: #ffedc8;
+  --fly-to: #ffecd9;
+}
+
+.tone-giveaway {
+  --fly-from: #e8efff;
+  --fly-to: #efedff;
+}
+
+:root.theme-dark .tone-stars {
+  --fly-from: #251a00;
+  --fly-to: #2b1700;
+  --fly-blend: plus-lighter;
+}
+
+:root.theme-dark .tone-giveaway {
+  --fly-from: #05104c;
+  --fly-to: #21094a;
+  --fly-blend: plus-lighter;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not(.theme-light) .tone-stars {
+    --fly-from: #251a00;
+    --fly-to: #2b1700;
+    --fly-blend: plus-lighter;
+  }
+
+  :root:not(.theme-light) .tone-giveaway {
+    --fly-from: #05104c;
+    --fly-to: #21094a;
+    --fly-blend: plus-lighter;
+  }
+}
+
+/* Dark pages per tone: Premium's indigo night, and for Stars and giveaways bg_color itself, true black on iOS. Each
+   page's light paints its own page, so a change of tone fades one into the other; the root takes the shown screen's,
+   so the body under the field and the bar follow it, from the moment the other one starts to leave. The shell copies
+   each screen's tone onto its wrapper (data-tone, src/ui/shell.ts): WebKit re-matches a :root:has() only when what
+   changes is the last compound of its argument, so .screen:not(.is-leaving) > .tone-stars would keep the root black
+   until the leaving page is removed. The page that goes carries is-going, which a Back mid-change moves to the
+   other, so the root follows the screen that stays from the turn on. The :has() rules stand alone: a client without
+   it drops only them. */
+:root.theme-dark .tone-premium {
+  --page: color-mix(in srgb, #22208f 18%, var(--tg-theme-bg-color, #000000));
+  --page-top-base: var(--page);
+}
+
+:root.theme-dark :is(.tone-stars, .tone-giveaway) {
+  --page: var(--tg-theme-bg-color, #000000);
+  --page-top-base: var(--page);
+}
+
+:root.theme-dark:has(.screen:not(.is-going, [hidden]):is([data-tone='stars'], [data-tone='giveaway'])) {
+  --page: var(--tg-theme-bg-color, #000000);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not(.theme-light) .tone-premium {
+    --page: color-mix(in srgb, #22208f 18%, var(--tg-theme-bg-color, #000000));
+    --page-top-base: var(--page);
+  }
+
+  :root:not(.theme-light) :is(.tone-stars, .tone-giveaway) {
+    --page: var(--tg-theme-bg-color, #000000);
+    --page-top-base: var(--page);
+  }
+
+  :root:not(.theme-light):has(.screen:not(.is-going, [hidden]):is([data-tone='stars'], [data-tone='giveaway'])) {
+    --page: var(--tg-theme-bg-color, #000000);
+  }
+}
+
+/* Android and desktop colour section headers with the client's accent, Telegram blue: a toned screen gives them its
+   one hue, as those clients do with an accent the user picks. iOS headers stay grey. */
+html:not(.platform-ios) :is(.tone-premium, .tone-stars, .tone-giveaway) {
+  --section-header: var(--tone-ink);
+}
+
+/* Root size per platform: rem follows the platform's body size, and on iOS Dynamic Type. Only touch devices take
+   the system body size: WebKit on a Mac answers 13 px, which would shrink the iOS frame in the dev host. */
+html {
+  font-size: 17px;
+}
+
+@media (any-pointer: coarse) {
+  html.platform-ios {
+    font: -apple-system-body;
+  }
+}
+
+html.platform-android {
+  font-size: 16px;
+  --font: Roboto, system-ui, sans-serif;
+  --font-display: var(--font);
+  /* No rounded system face: numerals stay Roboto, proportional. */
+  --font-rounded: var(--font);
+  --island-radius: 16px;
+  /* Roboto has 400, 500 and 700, so 600 would render bold; Telegram's one emphasis weight is Medium
+     (AndroidUtilities.java bold()). The type ramp on a 16 px body. */
+  --fw-title: 500;
+  --fw-strong: 500;
+  --fw-medium: 500;
+  /* Telegram's 22 dp hero title (PremiumPreviewFragment.java), on a 28 px line. */
+  --fs-hero: calc(22rem / 16);
+  --lh-hero: calc(28.005 / 22);
+  --fs-title: calc(20rem / 16);
+  --lh-title: calc(28.005 / 20);
+  --lh-body: calc(20.005 / 16);
+  --lh-body-wrap: calc(20.005 / 16);
+  --fs-sub: calc(14rem / 16);
+  --lh-sub: calc(20.005 / 14);
+  --fs-small: calc(14rem / 16);
+  --lh-small: calc(20.005 / 14);
+  --lh-small-wrap: calc(20.005 / 14);
+  --fs-caption: calc(12rem / 16);
+  --lh-caption: calc(16.005 / 12);
+  --fs-badge: calc(12rem / 16);
+  --lh-pill: calc(20.005 / 12);
+  --fs-tab: calc(12rem / 16);
+  --fs-segment: calc(14rem / 16);
+  --fs-big: calc(32rem / 16);
+  --lh-big: calc(40.005 / 32);
+  --fs-num-l: calc(24rem / 16);
+  --lh-num-l: calc(32.005 / 24);
+  --fs-section-header: calc(15rem / 16);
+  --lh-section-header: calc(20.005 / 15);
+  --fw-section-header: 500;
+  --cell-min: calc(48rem / 16);
+}
+
+/* Telegram Desktop and macOS: the Fluent 2 ramp on a 14 px body, weights 400 and 600. The subhead keeps a 20 px line
+   rather than 18: hero subtitles wrap, and a 20 px step keeps every box under them on the grid. */
+html.platform-desktop {
+  font-size: 14px;
+  --font: 'Segoe UI Variable Text', 'Segoe UI', system-ui, -apple-system, Roboto, 'Noto Sans', sans-serif;
+  --font-display: 'Segoe UI Variable Display', 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
+  --font-rounded: ui-rounded, var(--font);
+  --fw-title: 600;
+  --fw-strong: 600;
+  --fw-medium: 600;
+  --gutter: 20px;
+  --section-inset: 20px;
+  --island-radius: 16px;
+  --fs-hero: calc(24rem / 14);
+  --lh-hero: calc(32.005 / 24);
+  --fs-title: calc(20rem / 14);
+  --lh-title: calc(28.005 / 20);
+  --lh-body: calc(20.005 / 14);
+  --lh-body-wrap: calc(20.005 / 14);
+  --fs-sub: calc(13rem / 14);
+  --lh-sub: calc(20.005 / 13);
+  --fs-small: calc(12rem / 14);
+  --lh-small: calc(16.005 / 12);
+  --lh-small-wrap: calc(16.005 / 12);
+  --fs-caption: calc(12rem / 14);
+  --lh-caption: calc(16.005 / 12);
+  --fs-badge: calc(12rem / 14);
+  --lh-pill: calc(20.005 / 12);
+  --fs-tab: calc(12rem / 14);
+  --fs-segment: var(--fs-sub);
+  --lh-segment: calc(18.005 / 13);
+  --fs-big: calc(40rem / 14);
+  --lh-big: calc(48.005 / 40);
+  --fs-num-l: calc(24rem / 14);
+  --lh-num-l: calc(32.005 / 24);
+  --fs-section-header: calc(13rem / 14);
+  --lh-section-header: calc(16.005 / 13);
+  --fw-section-header: 600;
+  --cell-min: calc(40rem / 14);
+}
+
+/* Telegram Desktop dark: all violet text takes a lighter ink, tier 2's and the pills' included, and red text a step
+   more of the text colour, so both hold 4.5:1 on its black cells and on a pill's tint. Desktop's section colour is
+   its bg_color, so a black cell there is the page's own colour and its hairline draws it. */
+html.platform-desktop.theme-dark {
+  --violet-ink: #b4a6ff;
+  --destructive-ink: color-mix(in srgb, var(--destructive) 55%, var(--text));
+}
+
+@media (prefers-color-scheme: dark) {
+  html.platform-desktop:not(.theme-light) {
+    --violet-ink: #b4a6ff;
+    --destructive-ink: color-mix(in srgb, var(--destructive) 55%, var(--text));
+  }
+}
+
+/* Android's and desktop's dark section colour is no lighter than bg_color, so a black cell there is about the page's
+   own colour. One even hairline draws its contour, as strong as a white island's edge on Telegram's iOS page
+   (1.15:1, 5.4 ΔL*). */
+html:is(.platform-android, .platform-desktop).theme-dark {
+  --rim-line: rgb(255 255 255 / 0.08);
+}
+
+@media (prefers-color-scheme: dark) {
+  html:is(.platform-android, .platform-desktop):not(.theme-light) {
+    --rim-line: rgb(255 255 255 / 0.08);
+  }
+}
+
+/* WebKit before 16.2 (iOS 15.0 to 16.1) has no color-mix(): a token holding one computes to nothing there, so the
+   dark page would turn transparent, white under white text. The theme's own colours stand in for the surfaces. Its
+   hint, accent and destructive read 2.8 to 4.0:1 as text, so each text ink is one colour per scheme, the normal path's
+   iOS ink or a step nearer the text: 4.5:1 or better on every client's page and island, hovered, pressed, chosen and
+   both, and on its 12% tint over the island. */
+@supports not (color: color-mix(in srgb, red, red)) {
+  :root {
+    --secondary-text: #484849;
+    --destructive-ink: #b32922;
+    --page-top: var(--page-top-base);
+  }
+
+  .tone-premium,
+  .tone-stars,
+  .tone-giveaway {
+    --page-top: var(--page-top-base);
+  }
+
+  .tone-stars,
+  .tone-giveaway {
+    --tone-ink: #005eb0;
+    --tone-tint: rgba(0, 94, 176, 0.12);
+  }
+
+  :root.theme-dark {
+    --page: var(--tg-theme-bg-color, #000000);
+    --island-surface: var(--tg-theme-section-bg-color, #2c2c2e);
+    --secondary-text: #bababa;
+    --destructive-ink: #f5a69d;
+  }
+
+  :root.theme-dark .tone-premium {
+    --page: var(--tg-theme-bg-color, #000000);
+  }
+
+  :root.theme-dark .tone-stars,
+  :root.theme-dark .tone-giveaway {
+    --tone-ink: #92bcfa;
+    --tone-tint: rgba(146, 188, 250, 0.12);
+  }
+
+  html.platform-desktop.theme-dark {
+    --destructive-ink: #f5a69d;
+  }
+
+  @media (prefers-color-scheme: dark) {
+    :root:not(.theme-light) {
+      --page: var(--tg-theme-bg-color, #000000);
+      --island-surface: var(--tg-theme-section-bg-color, #2c2c2e);
+      --secondary-text: #bababa;
+      --destructive-ink: #f5a69d;
+    }
+
+    :root:not(.theme-light) .tone-premium {
+      --page: var(--tg-theme-bg-color, #000000);
+    }
+
+    :root:not(.theme-light) .tone-stars,
+    :root:not(.theme-light) .tone-giveaway {
+      --tone-ink: #92bcfa;
+      --tone-tint: rgba(146, 188, 250, 0.12);
+    }
+
+    html.platform-desktop:not(.theme-light) {
+      --destructive-ink: #f5a69d;
+    }
+  }
+}
