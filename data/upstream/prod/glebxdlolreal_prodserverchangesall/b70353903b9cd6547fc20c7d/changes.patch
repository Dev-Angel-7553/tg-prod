+/* Design tokens: docs/product/design.md §2–3 and §11. Theme values come from the bridge as --tg-theme-*;
+   the --fb-* fallbacks apply outside Telegram and before the bridge has run. */
+
+:root {
+  --fb-page: #efeff4;
+  --fb-section: #ffffff;
+  --fb-text: #000000;
+  --fb-hint: #8e8e93;
+  --fb-link: #007aff;
+  --fb-button: #007aff;
+  --fb-button-text: #ffffff;
+  --fb-destructive: #ff3b30;
+  --fb-separator: rgba(60, 60, 67, 0.29);
+  /* Islands stay raised but crisp (design §11.7): a contact line and one short shadow pulled in under the island, so
+     12 px gaps stay the page colour. */
+  --island-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 6px 14px -8px rgb(0 0 0 / 0.12);
+  --contact-shadow: rgba(0, 0, 0, 0.3);
+  /* Accent text on the section colour and on its 12% tint, tuned for 4.5:1. */
+  --violet-ink: #6a4cf0;
+  /* The tier ladder's inks on their 12% tints (design §11.5). A pill's label is 12 to 13 px, so these hold 7:1, not
+     the 4.5:1 of running text; tier 2 takes a deeper step of the violet for the same reason. */
+  --tier-1-ink: #07518a;
+  --violet-pill-ink: #4c37ad;
+  --tier-3-ink: #812378;
+  /* A plan's pill pressed or hovered takes its row's darker surface (components.css): these inks keep 7:1 there. */
+  --violet-press-ink: #3c2991;
+  --tier-1-press-ink: #064a7c;
+  /* The saving line in Apple's accessible systemGreen, the same under every Telegram theme; in light a step darker
+     than its #248a3d (4.40:1 on white), the lightest that holds 4.5:1 on every light island in every state, chosen,
+     hovered and pressed together included. */
+  --saving-ink: #1a6e2f;
+  /* The lift of a chosen option's island (components.css .plan-fill):
+     the screen's accent ink at the opacity --chosen-a over the whole island and --chosen-edge on its inner edge; every
+     text on it holds 4.5:1. */
+  --chosen-a: 0.08;
+  --chosen-edge: 0.24;
+  /* Best Value's glint (src/fx/light.ts bestValueGlint): how white its head burns and how strong its light is. On a
+     light page white reads as a break in the ring, so the light keeps to the ring's own colours; on the tab's fill
+     its head keeps its white through the label and half of it at the tab's end, short of washing the end out. */
+  --glint-white: 0%;
+  --glint-tab-white: 70%;
+  --glint-tab-end: 0.5;
+  --glint-a: 95%;
+  --skeleton: rgba(118, 118, 128, 0.2);
+  /* Light (design.md §11.9). Light theme: the sources in saturated colour over a white bloom, no grey haze. The
+     page's fireflies are pastels a hair under the page's luminance (iOS #efeff4): they colour the gaps and set the
+     white islands off more, never lifting the page towards them, and Premium's violet ink keeps 4.5:1 on them under
+     the grain's darkest pixel. Premium's run from indigo at the page's top to magenta at its end, with as
+     much colour as sRGB holds at that luminance. */
+  --neon-blur: 14px;
+  --neon-spread: -6px;
+  --neon-lean: 8px;
+  --neon-a: 100%;
+  --neon-core: 70%;
+  --neon-contact: 0 1px 2px rgb(0 0 0 / 0.05);
+  --rim-line: transparent;
+  --pool-base: rgb(255 255 255 / 0.95);
+  --pool-top: 24%;
+  --pool-a: 24%;
+  --fly-from: #ebeeff;
+  --fly-to: #ffe8f9;
+  --fly-blend: normal;
+  --page-top-a: 8%;
