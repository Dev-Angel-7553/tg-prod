+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  box-shadow:
+    -8px 10px 32px -12px color-mix(in srgb, var(--glow-from) var(--cta-bloom-a), transparent),
+    8px 10px 32px -12px color-mix(in srgb, var(--glow-to) var(--cta-bloom-a), transparent);
+  opacity: 0;
