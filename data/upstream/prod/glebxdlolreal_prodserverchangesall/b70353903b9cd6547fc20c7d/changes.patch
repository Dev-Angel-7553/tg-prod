+    animation-name: fx-rise-in;
+  }
+
+  html.platform-android .screen.is-leaving-pop {
+    animation-name: fx-rise-out;
+  }
+
+  html.platform-android .screen.is-leaving-push,
+  html.platform-android .screen.is-entering-pop {
