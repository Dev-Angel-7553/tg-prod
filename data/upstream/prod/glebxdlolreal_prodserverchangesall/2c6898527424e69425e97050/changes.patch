+    }
+    var zip = new JSZip();
+    for (var i = 0; i < files.length; i++) {
+      var file = files[i];
+      zip.file(file.name, file.content, {binary: file.binary});
+    }
+    zip.generateAsync({
+      type: 'blob',
+      compression: 'DEFLATE'
+    }).then(function (zip_file) {
+      Editor.saveThemeRequest(zip_file, thumb, payload);
+    });
+  }
