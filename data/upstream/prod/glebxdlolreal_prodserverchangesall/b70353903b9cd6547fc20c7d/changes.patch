+  }
+}
+
+/* Result layout: the hero's rhythm (design §11.3) with the 120 px mark. */
+.result {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: var(--space-8) var(--gutter) var(--space-32);
+  text-align: center;
+}
+
+.result-media {
+  margin-bottom: var(--space-16);
+}
+
+.result-title {
+  font-family: var(--font-display);
+  font-size: var(--fs-hero);
+  font-weight: var(--fw-title);
+  line-height: var(--lh-hero);
+  text-wrap: balance;
+}
+
+.result-text {
+  max-width: 34em;
+  color: var(--secondary-text);
+  margin-top: var(--space-8);
+  font-size: var(--fs-sub);
+  line-height: var(--lh-sub);
+  text-wrap: balance;
+}
+
+.result-text:empty {
+  display: none;
+}
+
+/* Rows bleed out of the padding so their sections take the screen's own side insets. */
