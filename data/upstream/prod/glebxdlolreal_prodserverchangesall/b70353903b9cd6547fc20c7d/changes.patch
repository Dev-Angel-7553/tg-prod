+.plan-saving {
+  color: var(--saving-ink);
+  font-size: var(--fs-small);
+  font-weight: var(--fw-medium);
+  line-height: var(--lh-small);
+}
+
+/* Best Value tab: a sparkle and the label on the deep gradient, 12/16, centred on the card's top edge at its end
+   side; the line's height holds with the sparkle alone too (gift cards). The sparkle is drawn here, not in the
+   translated label. Placed absolutely, so the card's content does not move; any position: relative card with its own
+   stacking context can host it. The tab makes none of its own, so the glint and the sparkle's flare light its fill
+   and pass under the sparkle and the label (design.md §11.9): the fill at 1, the light at 2, the sparkle and the
+   label at 3, all over the ring. */
+.plan-tab {
+  position: absolute;
+  top: calc(var(--fs-tab) * var(--lh-tab) / -2);
+  inset-inline-end: var(--space-16);
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  height: calc(var(--fs-tab) * var(--lh-tab));
+  padding: 0 var(--space-8);
+  border-radius: var(--badge-radius);
+  color: var(--best-on-fill);
+  font-size: var(--fs-tab);
+  font-weight: var(--fw-tab);
+  line-height: var(--lh-tab);
+  white-space: nowrap;
+  pointer-events: none;
+}
+
+.plan-tab::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  border-radius: inherit;
+  background: var(--best-fill);
+}
+
+.plan-tab-label {
+  z-index: 3;
+}
+
+/* The 10 px glyph in a box 12 px tall, centred in the 16 px line, so the box keeps to the 4 px grid. */
+.plan-tab-spark {
+  z-index: 3;
+  flex: none;
+  width: 10px;
+  height: 12px;
+  background: currentColor;
+  -webkit-mask: url(../img/premiumbot/ui-sparkle.svg) center / 10px 10px no-repeat;
+  mask: url(../img/premiumbot/ui-sparkle.svg) center / 10px 10px no-repeat;
+}
+
+/* The sparkle's flare (src/fx/light.ts bestValueGlint): the tone's light round it, white at its heart, over the fill
+   and under the sparkle and the label, on the (1 − t²)² falloff. Still and clear until a breath's peak lights it. */
+.plan-tab-flare {
+  position: absolute;
+  top: calc(50% - 12px);
+  inset-inline-start: calc(var(--space-8) + 5px - 12px);
+  z-index: 2;
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  background: radial-gradient(
+    closest-side,
+    color-mix(in srgb, #fff 90%, var(--glow-from)),
+    color-mix(in srgb, #fff 45%, var(--glow-from)) 30%,
+    color-mix(in srgb, var(--glow-from) 41%, transparent) 60%,
+    color-mix(in srgb, var(--glow-from) 13%, transparent) 80%,
+    transparent
+  );
+  opacity: 0;
+  pointer-events: none;
+}
+
+/* Best Value's glint (premiumbot-fx.js mountGlint, design.md §11.9): one light out of the sparkle, clockwise round the
+   card's ring and back into it. Its layer covers the ring and the 8 px gap outside it in nine stretches, the sides
+   and the corners from the sparkle on, so the light turns with the corners, never crosses the card's content and is
+   spent before the next card; over the ring and the tab's fill, under the sparkle it leaves from and the label.
+   Across the band the light is whole over the ring and falls to nothing over the gap on the (1 − t²)² falloff
+   (--glint-haze from the gap's outer edge in, --glint-haze-turn from a corner's centre out, its inner edge softened
+   within the ring's own width); its white core keeps to the ring and 3 px of the gap.
+   The layer's mask is clear but for the tab's box, which the script measures: there the light keeps a quarter of its
+   strength, so the white label holds 3:1 over the lit fill, and none at the sparkle's centre, which it leaves and
+   enters softly. */
+.plan-glint {
+  --glint-out: var(--space-8);
+  --glint-haze:
+    #0000, #00000021 calc(var(--glint-out) * 0.2), #00000069 calc(var(--glint-out) * 0.4),
+    #000000b5 calc(var(--glint-out) * 0.6), #000000eb calc(var(--glint-out) * 0.8), #000 var(--glint-out);
+  --glint-haze-turn:
+    #0000 calc(var(--glint-radius) - var(--best-ring)), #000 calc(var(--glint-radius) - var(--best-ring) + 1px),
+    #000 var(--glint-radius), #000000eb calc(var(--glint-radius) + var(--glint-out) * 0.2),
+    #000000b5 calc(var(--glint-radius) + var(--glint-out) * 0.4), #00000069 calc(var(--glint-radius) + var(--glint-out) * 0.6),
+    #00000021 calc(var(--glint-radius) + var(--glint-out) * 0.8), #0000 calc(var(--glint-radius) + var(--glint-out));
+  --glint-core: #0000 calc(var(--glint-out) - 3px), #000 var(--glint-out);
+  --glint-core-turn:
+    #0000 calc(var(--glint-radius) - var(--best-ring)), #000 calc(var(--glint-radius) - var(--best-ring) + 1px),
+    #000 var(--glint-radius), #0000 calc(var(--glint-radius) + 3px);
+  position: absolute;
+  inset: calc(-1 * var(--glint-out));
+  z-index: 2;
+  -webkit-mask:
+    linear-gradient(
+        90deg,
+        #0000,
+        #000000bf 6px,
+        #000000bf calc(var(--glint-spark) - 6px),
+        #000 var(--glint-spark),
+        #000000bf calc(var(--glint-spark) + 6px),
+        #000000bf calc(100% - 6px),
+        #0000
+      )
+      var(--glint-tab) no-repeat,
+    linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor;
+  mask:
+    linear-gradient(
+        90deg,
+        #0000,
+        #000000bf 6px,
+        #000000bf calc(var(--glint-spark) - 6px),
+        #000 var(--glint-spark),
+        #000000bf calc(var(--glint-spark) + 6px),
+        #000000bf calc(100% - 6px),
+        #0000
+      )
+      var(--glint-tab) no-repeat exclude,
+    linear-gradient(#000 0 0);
+  pointer-events: none;
+}
+
+/* A stretch of the band: the script sizes it and moves its light through it. */
+.plan-glint-part {
+  position: absolute;
+  overflow: hidden;
+}
+
+/* A side's light, as long as the light is: its strength along its way is the script's (--glint-run: the front, the
+   peak, the long afterglow). The ring's colour lies over the gap alone, so on the ring the white lights the ring's own
+   colours. Unlit it stands its own length before the side's start, out of sight. */
+.plan-glint-beam {
+  --glint-hue: var(--glow-from);
+  position: absolute;
+  -webkit-mask: linear-gradient(var(--glint-way), var(--glint-run)), linear-gradient(var(--glint-across), var(--glint-haze));
+  -webkit-mask-composite: source-in, source-over;
+  mask: linear-gradient(var(--glint-way), var(--glint-run)) intersect, linear-gradient(var(--glint-across), var(--glint-haze));
+}
+
+.plan-glint-part.is-end > .plan-glint-beam {
+  --glint-hue: var(--glow-to);
+}
+
+/* Down the left and the right the ring keeps one colour. */
+.plan-glint-beam:empty {
+  background: linear-gradient(var(--glint-across), var(--glint-hue) var(--glint-out), #0000 var(--glint-out));
+}
+
+/* Along the top and the bottom it changes under the light: the colours lie in the light as wide as the card, and the
+   script moves them against it, so they stay with the ring. */
+.plan-glint-hue {
+  position: absolute;
+  background: linear-gradient(90deg, var(--glow-from) var(--glint-radius), var(--glow-to) calc(100% - var(--glint-radius)));
+}
+
+/* The head: a round white bloom on the light's peak, where the script puts it (--glint-bloom), over the colours. */
+.plan-glint-beam::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  background: rgb(255 255 255 / var(--glint-white));
+  -webkit-mask: radial-gradient(circle 9px at var(--glint-bloom), #000, #000000eb 20%, #000000b5 40%, #00000069 60%, #00000021 80%, #0000);
+  mask: radial-gradient(circle 9px at var(--glint-bloom), #000, #000000eb 20%, #000000b5 40%, #00000069 60%, #00000021 80%, #0000);
+}
+
+/* The core: the head's white (tokens.css --glint-white), thinning down the tail as the script draws it. */
+.plan-glint-beam::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  background: rgb(255 255 255 / var(--glint-white));
+  -webkit-mask: linear-gradient(var(--glint-way), var(--glint-run-core)), linear-gradient(var(--glint-across), var(--glint-core));
+  -webkit-mask-composite: source-in, source-over;
+  mask: linear-gradient(var(--glint-way), var(--glint-run-core)) intersect, linear-gradient(var(--glint-across), var(--glint-core));
+}
+
+/* A corner's light: the same strengths along a conic gradient, which the script turns about the corner's centre, and
+   across the band on circles round that centre. Clear until the script lights it. */
+.plan-glint-part.is-turn > .plan-glint-beam {
+  background: radial-gradient(circle, #0000 calc(var(--glint-radius) - 0.5px), var(--glint-hue) calc(var(--glint-radius) + 0.5px));
+  opacity: 0;
+  -webkit-mask: conic-gradient(var(--glint-arc)), radial-gradient(circle, var(--glint-haze-turn));
+  -webkit-mask-composite: source-in, source-over;
+  mask: conic-gradient(var(--glint-arc)) intersect, radial-gradient(circle, var(--glint-haze-turn));
+}
+
+.plan-glint-part.is-turn > .plan-glint-beam::after {
+  -webkit-mask: conic-gradient(var(--glint-arc-core)), radial-gradient(circle, var(--glint-core-turn));
+  -webkit-mask-composite: source-in, source-over;
+  mask: conic-gradient(var(--glint-arc-core)) intersect, radial-gradient(circle, var(--glint-core-turn));
+}
+
+/* The glint's way out of the tab (premiumbot-fx.js mountGlint): the same light the tab's height, over its fill from the
+   sparkle to its end, where the ring's light takes over, so the run is seen to leave the tab. Under the flare, the
+   sparkle and the label; clear left of the sparkle's centre, which it leaves softly, and down to --glint-tab-end of
+   itself at the tab's end (tokens.css). The script sizes and moves it. */
+.plan-tab-run {
+  --glint-hue: var(--glow-to);
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  overflow: hidden;
+  border-radius: inherit;
+  -webkit-mask: linear-gradient(90deg, #0000 var(--glint-spark), #000 calc(var(--glint-spark) + 6px), #000 calc(100% - 20px), rgb(0 0 0 / var(--glint-tab-end)));
+  mask: linear-gradient(90deg, #0000 var(--glint-spark), #000 calc(var(--glint-spark) + 6px), #000 calc(100% - 20px), rgb(0 0 0 / var(--glint-tab-end)));
+  pointer-events: none;
+}
+
+.plan-tab-ray,
+.plan-tab-ray::before,
+.plan-tab-ray::after {
+  position: absolute;
+}
+
+.plan-tab-ray::before,
+.plan-tab-ray::after {
+  content: '';
+  inset: 0;
+}
+
+/* Its colour at half strength, so the label stays readable in the afterglow. */
+.plan-tab-ray::before {
+  background: var(--glint-hue);
+  -webkit-mask: linear-gradient(90deg, var(--glint-run)), linear-gradient(#00000080, #00000080);
+  -webkit-mask-composite: source-in, source-over;
+  mask: linear-gradient(90deg, var(--glint-run)) intersect, linear-gradient(#00000080, #00000080);
+}
+
+.plan-tab-ray::after {
+  background: rgb(255 255 255 / var(--glint-tab-white));
+  -webkit-mask: radial-gradient(circle 9px at var(--glint-bloom), #000, #000000eb 20%, #000000b5 40%, #00000069 60%, #00000021 80%, #0000);
+  mask: radial-gradient(circle 9px at var(--glint-bloom), #000, #000000eb 20%, #000000b5 40%, #00000069 60%, #00000021 80%, #0000);
+}
+
+/* Before WebKit 16.2 the flare cannot mix its light: it takes its hue whole under an alpha mask on the same falloff,
+   a white heart over it. The glint mixes no colours, so it paints the same there. */
+@supports not (color: color-mix(in srgb, red, red)) {
+  .plan-tab-flare {
+    background: radial-gradient(closest-side, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0) 60%) var(--glow-from);
+    -webkit-mask: radial-gradient(closest-side, #000 30%, #00000069 60%, #00000021 80%, #0000);
+    mask: radial-gradient(closest-side, #000 30%, #00000069 60%, #00000021 80%, #0000);
+  }
+}
+
+/* The billed price leads the right column: bold at the body size, in the text colour (design §11.4). */
+.plan-price {
+  color: var(--text);
+  font-size: var(--fs-body);
+  font-weight: var(--fw-strong);
+  line-height: var(--lh-body);
+  font-variant-numeric: tabular-nums;
+}
+
+.price-regular {
+  color: var(--secondary-text);
+  text-decoration: line-through;
+}
+
+/* Discount badge: the screen's ink on its 12% tint (design §11.1), or its tier's, rounded numerals
+   (PremiumOptionComponent.swift). The 20 px line is the pill's height; 8 px sides keep the 4 px grid where Telegram
+   has 6. */
+.badge {
+  display: inline-block;
+  padding: 0 var(--space-8);
+  border-radius: var(--badge-radius);
+  background: var(--tier-tint, var(--tone-tint));
+  color: var(--tier-ink, var(--tone-ink));
+  font-family: var(--font-badge);
+  font-size: var(--fs-badge);
+  font-weight: var(--fw-badge);
+  line-height: var(--lh-pill);
+  white-space: nowrap;
+}
+
+/* On a plan the tint lies on the plain island, opaque, so a chosen option's lift (.plan-fill) leaves the pill and its
+   4.5:1 ink as they are; tier 3's pill is its own opaque fill already. Pressed or hovered, the pill takes its row's
+   surface as the row does, at the row's pace, and an ink a step further from it that keeps 4.5:1 there; the upgrade
+   offer presses its cards as one (screens-subscription.css). */
+.cell--plan:not(.plan-tier--3) .badge {
+  background-color: var(--island-surface);
+  background-image: linear-gradient(var(--tier-tint, var(--tone-tint)), var(--tier-tint, var(--tone-tint)));
+}
+
+.platform-ios .cell--plan:not(.plan-tier--3) .badge {
+  transition: background-color 0.45s ease-out, color 0.45s ease-out;
+}
+
+.platform-ios :is(.is-tappable:active:not([aria-disabled='true']):not(:disabled):not(.is-disabled), .upgrade-offer:active) :is(.cell--plan:not(.plan-tier--3) .badge) {
+  background-color: var(--press, var(--pressed));
+  color: var(--tier-press-ink, var(--violet-press-ink));
+  transition: none;
+}
+
+.platform-android .cell--plan:not(.plan-tier--3) .badge {
+  transition: background-color 0.15s ease-out, color 0.15s ease-out;
+}
+
+.platform-android :is(.is-tappable:active:not([aria-disabled='true']):not(:disabled):not(.is-disabled), .upgrade-offer:active) :is(.cell--plan:not(.plan-tier--3) .badge) {
+  background-color: var(--press, var(--pressed));
+  color: var(--tier-press-ink, var(--violet-press-ink));
+}
+
+.platform-desktop :is(.is-tappable:hover:not([aria-disabled='true']):not(:disabled):not(.is-disabled), .upgrade-offer:hover) :is(.cell--plan:not(.plan-tier--3) .badge) {
+  background-color: var(--hover-bg, var(--hover));
+  color: var(--tier-press-ink, var(--violet-press-ink));
+}
+
+/* Before 16.2 the row darkens under a veil (above), so its pill takes the same veil under its tint. */
+@supports not (color: color-mix(in srgb, red, red)) {
+  :is(.platform-ios, .platform-android) :is(.is-tappable:active:not([aria-disabled='true']):not(:disabled):not(.is-disabled), .upgrade-offer:active) :is(.cell--plan:not(.plan-tier--3) .badge) {
+    background-image: linear-gradient(var(--tier-tint, var(--tone-tint)), var(--tier-tint, var(--tone-tint))), linear-gradient(var(--pressed), var(--pressed));
+  }
+
+  .platform-desktop :is(.is-tappable:hover:not([aria-disabled='true']):not(:disabled):not(.is-disabled), .upgrade-offer:hover) :is(.cell--plan:not(.plan-tier--3) .badge) {
+    background-image: linear-gradient(var(--tier-tint, var(--tone-tint)), var(--tier-tint, var(--tone-tint))), linear-gradient(var(--hover), var(--hover));
+  }
+}
+
+/* On an offer (src/ui/screens/subscription-ui.ts offerShimmer: the upgrade screen and the upgrade offers), Best
+   Value's discount shimmers: once a breath a soft band of light, a raised cosine that peaks at 25 % white, sweeps
+   through the pill in 2 s centred on the breath's low (src/fx/light.ts), half a breath from the peak where the ring's
+   own light is brightest. Only the band's transform moves; the pill clips it, under the white numerals. Unlit, under
+   reduced motion and in snap mode, the band waits outside the pill. */
+.offer-shimmer .plan-tier--3 .badge {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+}
+
+.offer-shimmer .plan-tier--3 .badge::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(
+    90deg,
+    rgb(255 255 255 / 0),
+    rgb(255 255 255 / 0.037) 12.5%,
+    rgb(255 255 255 / 0.125) 25%,
+    rgb(255 255 255 / 0.213) 37.5%,
+    rgb(255 255 255 / 0.25) 50%,
+    rgb(255 255 255 / 0.213) 62.5%,
+    rgb(255 255 255 / 0.125) 75%,
+    rgb(255 255 255 / 0.037) 87.5%,
+    rgb(255 255 255 / 0)
+  );
+  transform: translateX(-100%);
+  pointer-events: none;
+}
+
+.offer-shimmer.neon-lit .plan-tier--3 .badge::after {
+  animation: badge-shimmer 8s linear var(--neon-delay, 0s) infinite;
+}
+
+/* Motion reduced while lit: still at once, before the light catches up. */
+.fx-reduce .offer-shimmer .plan-tier--3 .badge::after {
+  animation: none;
+}
+
+@keyframes badge-shimmer {
+  0%,
+  37.5% {
+    transform: translateX(-100%);
+    animation-timing-function: ease-in-out;
+  }
+
+  62.5%,
+  100% {
+    transform: translateX(100%);
+  }
+}
+
+/* Hero */
+.hero {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: var(--space-8) var(--gutter) var(--space-32);
+  text-align: center;
+}
+
+/* Hero rhythm (design §11.3): 24 px under the header with the screen's 16, the mark, 16, title, 8, subtitle, 32.
+   The stage behind paints the only glow. */
+.hero-media {
+  position: relative;
+  margin-bottom: var(--space-16);
+}
+
+.hero-title {
+  font-family: var(--font-display);
+  font-size: var(--fs-hero);
+  font-weight: var(--fw-title);
+  line-height: var(--lh-hero);
+  text-wrap: balance;
+}
+
+.hero-subtitle {
+  max-width: 34em;
+  margin-top: var(--space-8);
+  color: var(--secondary-text);
+  font-size: var(--fs-sub);
+  line-height: var(--lh-sub);
+  text-wrap: balance;
+}
+
+.hero-subtitle:empty {
+  display: none;
+}
+
+/* Emphasis inside subtitles is semibold in the subtitle's own colour (PremiumIntroScreen.swift markdown). */
+:is(.hero-subtitle, .result-text) b {
+  font-weight: var(--fw-strong);
+}
+
+.screen-title {
+  padding: 0 var(--gutter) var(--space-16);
+  font-family: var(--font-display);
+  font-size: var(--fs-title);
+  font-weight: var(--fw-title);
+  line-height: var(--lh-title);
+}
+
+/* Lottie */
+.lottie {
+  position: relative;
+  display: block;
+  flex: none;
+}
+
+.lottie canvas {
+  position: relative;
+}
+
+.lottie.is-tappable {
+  border-radius: 50%;
+}
+
+/* No disc behind it (design §11.7): the glyph itself takes the animation's colour. */
+.lottie-fallback {
+  position: absolute;
+  inset: 16%;
+  display: grid;
+  place-items: center;
+}
+
+.lottie-fallback .icon {
+  width: 100%;
+  height: 100%;
+  background: var(--fallback-bg, var(--brand-gradient));
+}
+
+.lottie.is-ready .lottie-fallback {
+  display: none;
+}
+
+.lottie-celebrate {
+  position: fixed;
+  inset: 0;
+  z-index: 5;
+  pointer-events: none;
+}
+
+/* Banner: the glyph in the radio cells' column and as large as their radio, 22 px on iOS and
+   desktop (a 24 px box at 0.9167) and 24 px on Android, centred on the first line; an error's title, its point, in red
+   over the rest in the secondary ink (src/ui/components/banner.ts splitLead). */
+.banner {
+  --banner-line: calc(var(--fs-small) * var(--lh-small-wrap));
+  --radio: 22px;
+  position: relative;
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-12);
+  margin: 0 var(--gutter) var(--space-16);
+  padding: var(--space-12) var(--space-16);
+  padding-inline-start: calc(var(--space-16) + 24px + var(--space-12));
+  color: var(--text);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small-wrap);
+  text-align: start;
+}
+
+.platform-android .banner {
+  --radio: 24px;
+}
+
+.banner--titled {
+  --banner-line: calc(var(--fs-sub) * var(--lh-sub));
+}
+
+button.banner {
+  width: calc(100% - 2 * var(--gutter));
+}
+
+/* The glyph's box is the first line, so a one-line banner is as tall as its line; the glyph overflows it. */
+.banner-mark {
+  position: absolute;
+  top: var(--space-12);
+  inset-inline-start: var(--space-16);
+  width: 24px;
+  height: var(--banner-line);
+}
+
+.banner-icon {
+  position: absolute;
+  top: calc(50% - 14px);
+  inset-inline-start: -2px;
+  width: 28px;
+  height: 28px;
+  color: var(--accent);
+  -webkit-mask-size: var(--radio);
+  mask-size: var(--radio);
+}
+
+/* The rings: ui-warning's spans 21.9 of its 28 units, ui-info's 21.33 of 30. */
+.banner-icon[data-icon='ui-warning'] {
+  -webkit-mask-size: calc(var(--radio) * 28 / 21.9);
+  mask-size: calc(var(--radio) * 28 / 21.9);
+}
+
+.banner-icon[data-icon='ui-info'] {
+  -webkit-mask-size: calc(var(--radio) * 30 / 21.33);
+  mask-size: calc(var(--radio) * 30 / 21.33);
+}
+
+.banner--warning .banner-icon {
