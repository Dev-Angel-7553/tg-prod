+        if (result.new_token) {
+          Aj.state.token = result.new_token;
+        }
+        if (result.new_token_value) {
+          $('.js-token-value', Aj.ajContainer).value(result.new_token_value);
+        }
+        if (result.toast) {
+          showToast(result.toast);
+        }
+      });
+    });
+    return false;
+  },
+  eApiSubmitForm: function(e) {
+    e.preventDefault();
