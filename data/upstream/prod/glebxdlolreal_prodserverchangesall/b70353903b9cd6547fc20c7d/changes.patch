+.field textarea {
+  display: block;
+  width: 100%;
+  min-height: calc(4em * var(--lh-body));
+  padding: 0;
+  border: 0;
+  outline: none;
+  resize: none;
+  overflow: hidden;
+  background: transparent;
+  font-size: var(--fs-body);
+  line-height: var(--lh-body);
+}
+
+.field textarea::placeholder {
+  color: var(--hint);
+  opacity: 1;
+}
+
+.field-counter {
+  display: block;
+  margin-top: var(--space-4);
+  color: var(--secondary-text);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small);
+  text-align: end;
+}
+
+.field-counter.is-over {
+  color: var(--destructive-ink);
+}
+
+/* Underline and outline are drawn as inset shadows: they take no room and focus moves nothing. */
