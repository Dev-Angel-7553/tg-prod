+.drop:has(input:focus-visible) { outline: 2px solid color-mix(in srgb, var(--accent) 50%, transparent); outline-offset: 2px; }
+.drop-file { display: flex; align-items: center; gap: 12px; padding: 14px 10px 14px 16px; }
