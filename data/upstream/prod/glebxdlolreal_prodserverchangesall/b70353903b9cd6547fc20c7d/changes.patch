+/* Screens for gifts, Stars and giveaways (design.md §8.7–8.9, §11). The effects own the stage (fx.css): it follows
+   the theme and colours the text on it. This file keeps the screens on the 4 px grid (§11.3). */
+
+/* The hero rhythm on the stage: 24 px from the header to the mark (the stage's 16 and the hero's 8), 16 to the
+   title, 8 to the subtitle, then 32 to the first section, counting the sheet's 24 px rise and its 8 px padding. */
+.commerce-stage .hero {
+  padding-bottom: var(--space-24);
+}
+
+/* A failed load fills the screen and covers its bottom padding. */
+.commerce-stage.fx-stage--fill {
+  margin-bottom: -16px;
+}
+
+/* Centred content lands between grid lines on most viewports. Where CSS can round, the stage takes the viewport
+   height under the top safe areas (fx.css) rounded down to 8 px and the content sits at a grid step a little above the
+   middle. */
+@supports (padding-top: round(down, 100vh, 8px)) {
+  .commerce-stage.fx-stage--fill {
+    min-height: round(down, var(--fx-fill-height), 8px);
+  }
+
+}
+
+/* A banner under a full-screen stage clears the stage's pull into the bottom padding. */
+.commerce-stage.fx-stage--fill + .screen-banner {
+  padding-top: 32px;
+}
+
+/* The sheet (fx.css) rises over the stage; it also has to paint over the stage's content layer. */
+.commerce-sheet {
+  z-index: 1;
+}
+
+/* Gift: once someone is chosen, the stage shows who gets it in place of the gift, in the mark's 96 px. The box hugs
+   the 64 px avatars, so the contact shadow (design §11.7) sits right under them. */
+.avatar-stack {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 64px;
+  margin: var(--space-16) 0 var(--space-32);
+}
+
+/* Each 64 px avatar overlaps the next by 16 px. The next one is cut out around it with a 2 px gap, so the stage
+   shows through whatever its colour: the hole is centred on the previous avatar, 16 px before this one's edge. */
+.avatar-stack > * + * {
+  margin-inline-start: calc(-1 * var(--space-16));
+  -webkit-mask-image: radial-gradient(circle at -16px 50%, transparent 34px, #000 34.5px);
+  mask-image: radial-gradient(circle at -16px 50%, transparent 34px, #000 34.5px);
+}
+
+[dir='rtl'] .avatar-stack > * + * {
+  -webkit-mask-image: radial-gradient(circle at 80px 50%, transparent 34px, #000 34.5px);
+  mask-image: radial-gradient(circle at 80px 50%, transparent 34px, #000 34.5px);
+}
+
+.avatar-stack-more {
+  display: inline-grid;
+  place-items: center;
+  width: 64px;
+  height: 64px;
+  border-radius: 50%;
+  background: var(--section);
+  color: var(--text);
+  font-size: var(--fs-body);
+  font-weight: var(--fw-medium);
+}
+
+/* Gift durations (design §11.5): neutral cards side by side, 12 px apart, nothing inside but the words. The 16 px
+   under them hold the lower half of the chosen card's check, its ring included. */
+.gift-cards {
+  display: grid;
+  grid-auto-columns: minmax(0, 1fr);
+  grid-auto-flow: column;
+  gap: var(--space-12);
+  padding-bottom: var(--space-16);
+}
+
+/* Each card is an island (components.css) that takes the emphasis classes. The content is centred, so 12 px at the
+   sides is only clearance; it keeps "Save 1 198 ₽" on one line. 24 px on top keeps "12" 8 px clear of the ribbon's
+   band on the 106 px cards of a 375 pt screen; every card takes it, so the numerals line up. 24 px at the bottom keep
+   the last line 11 px clear of the check's ring. */
+.gift-card {
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: var(--space-24) var(--space-12);
+  color: var(--text);
+  text-align: center;
+  cursor: pointer;
+}
+
+/* On the 88 px cards of a 320 pt screen the ribbon's band comes within 4 px of "12"; 8 px more on top keeps it 8 clear. */
+@supports (container-type: inline-size) {
+  .gift-cards {
+    container-type: inline-size;
+  }
+
+  @container (width < 300px) {
+    .gift-card {
+      padding-top: var(--space-32);
+    }
+  }
+}
+
+/* Before Safari 16 the screen stands in for the row, which is the screen less the gutters: 16 px a side, 20 on
+   desktop. */
+@supports not (container-type: inline-size) {
+  @media (max-width: 331.98px) {
+    .gift-card {
+      padding-top: var(--space-32);
+    }
+  }
+
+  @media (max-width: 339.98px) {
+    .platform-desktop .gift-card {
+      padding-top: var(--space-32);
+    }
+  }
+}
+
+/* Selection draws no ring (design §11.8). The chosen card lifts a little (components.css .plan-fill), fills its
+   price pill with its tier's opaque fill, which no lift shows through, and hangs a check on its bottom edge: the 22 px
+   disc of Telegram's gift picker (GiftItemComponent.swift, select mode) in the tier's fill or the screen's
+   solid, centred on the edge and cut out of it by a 2 px ring in the page's colour. The top edge belongs to the Best
+   Value tab and the discount ribbon, so selection never meets them. The glyph fills the disc, so it draws 12 px wide,
+   as on the radios. */
+.gift-card-check {
+  position: absolute;
+  bottom: -11px;
+  left: calc(50% - 11px);
+  z-index: 2;
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: var(--tier-fill, var(--tone-solid));
+  box-shadow: 0 0 0 2px var(--page);
+  color: #fff;
+  visibility: hidden;
+}
+
+.gift-card-check .icon {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+/* The server prints the check empty: its glyph is drawn on the disc as a mask. */
+.gift-card-check:empty::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: currentColor;
+  -webkit-mask: url(../img/premiumbot/ui-check.svg) center / contain no-repeat;
+  mask: url(../img/premiumbot/ui-check.svg) center / contain no-repeat;
+}
+
+/* The chosen card is the one whose radio is checked; no script has to mark it (.is-selected). */
+.gift-card.is-selected .gift-card-check,
+.cell-input:checked ~ .gift-card-check {
+  visibility: visible;
+}
+
+/* The check springs in from nothing; with reduced motion it only appears. */
+@media (prefers-reduced-motion: no-preference) {
+  .gift-card-check {
+    transform: scale(0);
+    transition: transform 160ms ease-out, visibility 160ms;
+  }
+
+  .gift-card.is-selected .gift-card-check,
+  .cell-input:checked ~ .gift-card-check {
+    transform: none;
+    transition: transform 200ms var(--fx-spring), visibility 200ms;
+  }
+}
+
+.gift-card:has(.cell-input:focus-visible) {
+  outline: 2px solid var(--tone);
+  outline-offset: 2px;
+}
+
+/* The discount on Telegram's corner ribbon (GiftItemComponent.swift): Premium/GiftRibbon as drawn, 58 px and 2 px past
+   the top and end edges, its text 10 px semibold in white, turned 45° on the band's centre line 22 px from the
+   ribbon's corner. Telegram's gradient becomes the screen's solid on the neutral card, or the tier's fill. */
+.gift-card-ribbon {
+  position: absolute;
+  top: -2px;
+  inset-inline-end: -2px;
+  width: 58px;
+  height: 58px;
+  color: #fff;
+  font-size: 10px;
+  font-weight: var(--fw-strong);
+  line-height: 12px;
+  white-space: nowrap;
+  pointer-events: none;
+}
+
+.gift-card-ribbon::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  /* A quarter darker, so the 10 px white text keeps 4.5:1 on tier 1's #429bd5 too. */
+  background: linear-gradient(rgb(0 0 0 / 0.24), rgb(0 0 0 / 0.24)), var(--tier-fill, var(--tone-solid));
+  -webkit-mask: url(../img/premiumbot/gift-ribbon.svg) center / contain no-repeat;
+  mask: url(../img/premiumbot/gift-ribbon.svg) center / contain no-repeat;
+}
+
+.gift-card-ribbon-text {
+  position: absolute;
+  top: 22px;
+  left: 36px;
+  transform: translate(-50%, -50%) rotate(45deg);
+}
+
+[dir='rtl'] .gift-card-ribbon::before {
+  transform: scaleX(-1);
+}
+
+[dir='rtl'] .gift-card-ribbon-text {
+  left: 22px;
+  transform: translate(-50%, -50%) rotate(-45deg);
+}
+
+.gift-card-count {
+  font-family: var(--font-rounded);
+  font-size: var(--fs-num-l);
+  font-weight: var(--fw-num);
+  line-height: var(--lh-num-l);
+}
+
+/* Kept inside the card: a word longer than the card breaks rather than run into the next card. */
+.gift-card-unit {
+  max-width: 100%;
+  color: var(--secondary-text);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small);
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+}
+
+/* Telegram's price pill: the ink on its 12% tint, filled under white on the chosen card; the tier's ink, tint and fill
+   in the graded arm, else the screen's. 28 px tall with 12 px sides, the 4 px grid's nearest to Telegram's 30 and 9.
+   One weight in both states, so nothing reflows. */
+.gift-card-price {
+  display: inline-flex;
+  align-items: center;
+  height: 28px;
+  margin-top: var(--space-12);
+  padding: 0 var(--space-12);
+  border-radius: 14px;
+  background: var(--tier-tint, var(--tone-tint));
+  color: var(--tier-ink, var(--tone-ink));
+  font-size: var(--fs-sub);
+  font-weight: var(--fw-strong);
+  font-variant-numeric: tabular-nums;
+  line-height: var(--lh-sub);
+  white-space: nowrap;
+  transition: background-color 160ms ease-out, color 160ms ease-out;
+}
+
+.gift-card.is-selected .gift-card-price,
+.cell-input:checked ~ .gift-card-price {
+  background: var(--tier-fill, var(--tone-solid));
+  color: #fff;
+}
+
+/* A price that cannot keep 4 px inside its card's sides gives up, the whole row at once so the pills stay even
+   (gift-cards.ts keepPrices): its 12 px sides for 8; then its type for the 13/16 step of design §11.4 (12/16 on
+   Android and desktop); then its one line: the symbol and the amount on lines of their own, 16 px each, the pill 40 px
+   tall. */
+.gift-cards:is(.price-sides, .price-type, .price-lines) .gift-card-price {
+  padding: 0 var(--space-8);
+}
+
+.gift-cards:is(.price-type, .price-lines) .gift-card-price {
+  font-size: var(--fs-caption);
+  line-height: var(--lh-caption);
+}
+
+.gift-cards.price-lines .gift-card-price {
+  flex-direction: column;
+  height: auto;
+  padding: var(--space-4) var(--space-8);
+}
+
+/* "Save 353.400 ₫" on one line where the card holds it; else the amount takes the next line, whole (amountValue). */
+.gift-card-saving {
+  max-width: 100%;
+  margin-top: var(--space-4);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small);
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+}
+
+/* A Save line whose amount is wider than the card's content box, as LBP's 1,225,000 with its symbol is, runs out to
+   the pills' 4 px inset: the card's 12 px sides less 4, 8 px a side (gift-cards.ts keepPrices). */
+.gift-card-saving.is-wide {
+  max-width: calc(100% + 2 * var(--space-8));
+  margin-inline: calc(-1 * var(--space-8));
+}
+
+/* The Best Value tab's upper half needs room under the section header. */
+.gift-cards.has-best-value {
+  padding-top: var(--space-8);
+}
+
+/* On a narrow card the Best Value tab sits in the middle of the top edge, inside the card: one wider than its card
+   shows its sparkle alone (gift-cards.ts keepTab). */
+.gift-card .plan-tab {
+  inset-inline: 0;
+  width: max-content;
+  margin-inline: auto;
+}
+
+/* Tile sections: the tiles are the islands, straight on the page; the section's body is no surface of its own. */
+.section--tiles .section-body {
+  overflow: visible;
+  border-radius: 0;
+  background: none;
+  box-shadow: none;
+}
+
+/* Nor a rim (fx.css): on its square box it would draw an outline round the tiles. */
+.section--tiles > .section-body.island::after {
+  content: none;
+}
+
+/* The list, the stars_layout control: one card per pack, the cluster in a 40 px lead, the
+   amount 17/20 medium, the price at the end. Show More starts under the labels. */
+.section--pack-rows :is(.cell.has-tile, .cell--action) {
+  --sep-inset: calc(var(--space-16) + var(--avatar) + var(--space-12));
+}
+
+.section--pack-rows .cell--action {
+  padding-inline-start: var(--sep-inset);
+}
+
+.section--pack-rows .cell-title {
+  font-weight: var(--fw-medium);
+}
+
+/* The popular pack's tab, on the first card, needs room under the section header. */
+.section--pack-rows.has-top-tab .section-body {
+  padding-top: var(--space-8);
+}
+
+/* Stars packs (design §11.5): two columns of island tiles, a small gold cluster, the amount, the price. */
+.pack-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-12);
+}
+
+/* The popular pack's tab, in the first row, needs room under the section header. */
+.pack-grid.has-top-tab {
+  padding-top: var(--space-8);
+}
+
+.pack-tile {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: var(--space-16);
+  color: var(--text);
+  text-align: start;
+}
+
+.pack-tile .star-cluster {
+  margin-bottom: var(--space-12);
+}
+
+.pack-count {
+  max-width: 100%;
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+  font-size: var(--fs-body);
+  font-weight: var(--fw-medium);
+  line-height: var(--lh-body);
+}
+
+.pack-price {
+  color: var(--secondary-text);
+  font-size: var(--fs-sub);
+  line-height: var(--lh-sub);
+  font-variant-numeric: tabular-nums;
+}
+
+.pack-busy {
+  position: absolute;
+  inset-inline-start: var(--space-16);
+  bottom: var(--space-16);
+  width: 20px;
+  height: 20px;
+  color: var(--hint);
+}
+
+.pack-tile:not([aria-busy='true']) .pack-busy {
+  display: none;
+}
+
+.pack-tile[aria-busy='true'] .pack-price {
+  visibility: hidden;
+}
+
+.pack-more {
+  grid-column: 1 / -1;
+  min-height: var(--cell-min);
+  padding: 0 var(--space-16);
+  color: var(--accent);
+  font-size: var(--fs-body);
+  line-height: var(--lh-body);
+  text-align: center;
+}
+
+.platform-desktop .pack-tile:hover:not([aria-busy='true']),
+.platform-desktop .pack-more:hover {
+  background-color: var(--hover-bg);
+}
+
+/* Giveaways: all the winners chips fit the row; a longer server list still scrolls sideways. */
+.commerce .chips {
+  display: grid;
+  grid-auto-columns: minmax(44px, 1fr);
+  grid-auto-flow: column;
+  gap: var(--space-4);
+  padding: var(--space-8);
+}
+
+.commerce .chip {
+  display: block;
+}
+
+.commerce .chip-face {
+  width: 100%;
+  min-width: 0;
+  padding: 0;
+}
+
+/* The chosen chip is the screen's tone under a veil: Telegram's own button blues carry white at 2.7:1 to 3.5:1, and
+   the chip's number is small. This much darker holds 4.5:1 or better on every client's theme. */
+.commerce .cell-input:checked + .chip-face {
+  background-image: linear-gradient(rgb(0 0 0 / 0.28), rgb(0 0 0 / 0.28));
+}
+
+
+/* The picker return has no flow yet, so its failure sits in the middle of the page; at a grid step where CSS can
+   round, as on the full-screen stages. */
+.commerce--picker .result {
+  justify-content: center;
+  min-height: calc(var(--tg-viewport-stable-height, 100vh) - 64px);
+}
+
+@supports (padding-top: round(down, 100vh, 8px)) {
+  .commerce--picker .result {
+    justify-content: flex-start;
+    min-height: 0;
+    padding-top: max(var(--space-8), round(down, calc(var(--tg-viewport-stable-height, 100vh) / 2 - 176px), 8px));
+  }
+}
diff --git a/premiumbot-screens-subscription.css b/premiumbot-screens-subscription.css
@@ -0,0 +1,599 @@
+/* Screens for Premium itself (home, features, subscription, upgrade, resume, stop, result, settings, support): the
+   layout of design §11 around the fx.css effects. Screen roots carry their tone, so every accent comes from tokens.css. */
+
+/* Sheet geometry. fx.css owns it (src/fx/index.ts: the stage pulls up under the screen's top padding, its light
+   under the safe areas, and .fx-sheet rises over it); this zero-specificity rule only holds the layout until it does. */
+:where(.sheet) {
+  position: relative;
+  margin-top: -24px;
+}
+
+.stage-content,
+.stage-notice {
+  position: relative;
+  width: 100%;
+  max-width: var(--column);
+  margin: 0 auto;
+}
+
+.stage-content--fill {
+  padding-bottom: var(--space-24);
+}
+
+/* Hero rhythm (design §11.3): with the stage's own 24 px under it and the sheet's 8 px, the subtitle ends 32 px
+   above the first section. */
+.sub-stage .hero {
+  padding-bottom: var(--space-24);
+}
+
+/* A notice leads the stage, above the mark. */
+.stage-notice {
+  order: -1;
+}
+
+/* A full-screen block's title springs in: a finished result's. The pending page has no --fill block. */
+@media (prefers-reduced-motion: no-preference) {
+  .stage-content--fill .hero-title {
+    animation: sub-title-in 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
+  }
+}
+
+@keyframes sub-title-in {
+  from {
+    opacity: 0;
+    transform: scale(0.9);
+  }
+}
+
+/* Feature showcase, the paywall_features carousel arm on the features screen (design §11.5): neutral cards, the glyph
+   in the accent, under the screen title. */
+.showcase {
+  margin-bottom: var(--section-gap);
+}
+
+/* The track clips what overflows it: room for the islands' shadows, given back by its margins. */
+.showcase .fx-carousel__track {
+  margin-block: -20px -40px;
+  padding-block: var(--space-24) var(--space-48);
+}
+
+.showcase-card {
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+/* 160 px, or taller where the limits art's labels take second lines. */
+.showcase-art {
+  display: grid;
+  place-items: center;
+  min-height: 160px;
+}
+
+.showcase-glyph {
+  width: 64px;
+  height: 64px;
+  color: var(--tone);
+}
+
+/* Doubled Limits: one split bar per limit, Free in the neutral fill, Premium in the accent; values from
+   AppState.limits. */
+.showcase-art--limits {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: var(--space-8);
+  padding: var(--space-16);
+  place-items: stretch;
+}
+
+.limits-legend {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: var(--space-12);
+  color: var(--secondary-text);
+  font-size: var(--fs-caption);
+  line-height: var(--lh-caption);
+}
+
+.limits-key::before {
+  content: '';
+  display: inline-block;
+  width: 8px;
+  height: 8px;
+  margin-inline-end: var(--space-4);
+  border-radius: 50%;
+  background: var(--fill);
+}
+
+.limits-key--premium::before {
+  background: var(--tone);
+}
+
+/* The label's lines are as tall as the bars, so a label on two lines keeps the bars on its first line and the grid. */
+.limits-row {
+  display: grid;
+  grid-template-columns: 96px 1fr;
+  align-items: start;
+  gap: var(--space-8);
+}
+
+/* A label longer than its column takes a second line. */
+.limits-label {
+  min-width: 0;
+  font-size: var(--fs-caption);
+  line-height: var(--lh-pill);
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+}
+
+.limits-bars {
+  display: grid;
+  grid-template-columns: var(--share, 50%) 1fr;
+  overflow: hidden;
+  border-radius: var(--badge-radius);
+}
+
+.limits-bar {
+  min-width: 0;
+  padding: 0 var(--space-8);
+  font-size: var(--fs-badge);
+  font-weight: var(--fw-badge);
+  line-height: var(--lh-pill);
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+  text-align: end;
+}
+
+.limits-bar--free {
+  background: var(--fill);
+  color: var(--text);
+}
+
+.limits-bar--premium {
+  background: var(--tone-solid);
+  color: #fff;
+  /* A veil over the violet, so the bar's 12 px white figure holds 7:1. */
+  background-image: linear-gradient(rgb(0 0 0 / 0.22), rgb(0 0 0 / 0.22));
+}
+
+.showcase-title {
+  padding: 0 var(--space-16);
+  font-weight: var(--fw-medium);
+}
+
+.showcase-text {
+  padding: 0 var(--space-16) var(--space-16);
+  color: var(--secondary-text);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small-wrap);
+  text-wrap: pretty;
+}
+
+/* The paywall and Stars subtitles read in one voice: --text throughout, bold spans at 600 in the same colour. Status
+   subtitles elsewhere keep --hint. Written after fx.css, at its specificity. The server's Gift Stars root is the gift
+   root in the Stars tone. */
+.fx-stage:not(.fx-stage--dark) .hero-subtitle b {
+  color: inherit;
+}
+
+:is(.home--paywall, .commerce--stars, .commerce--stars-gift) .fx-stage .hero-subtitle,
+.commerce--gift.tone-stars .fx-stage .hero-subtitle {
+  color: var(--text);
+}
+
+/* The upgrade offer on the subscriber home, the resume screen and the details (design §8.2, §8.3, §8.5):
+   the upgrade screen's plan cards in one button. A button shrinks to fit, so it takes the cards' width. */
+.upgrade-offer {
+  display: block;
+  width: calc(100% - 2 * var(--gutter));
+}
+
+/* Its one chevron follows the header's text, in its colour and at its cap height, so the header reads as a link. */
+.upgrade-offer .section-header {
+  align-items: center;
+  gap: var(--space-4);
+}
+
+.upgrade-offer .section-header-text {
+  flex: 0 1 auto;
+}
+
+.upgrade-offer .section-header .cell-chevron {
+  width: 16px;
+  height: 16px;
+  margin: 0;
+  color: inherit;
+  opacity: 1;
+}
+
+/* The header's 8 px and 8 more put a first card's top edge 16 px under the header, as on Gift Premium
+   (screens-commerce.css), so its Best Value tab clears the header text by 8. */
+.upgrade-offer .section-body > :first-child:has(> .plan-tab) {
+  margin-top: var(--space-8);
+}
+
+/* Pressed, the cards darken together, as one island does (components.css .is-tappable). */
+.platform-ios .upgrade-offer .island {
+  transition: background-color 0.45s ease-out;
+}
+
+.platform-ios .upgrade-offer:active .island {
+  background-color: var(--press);
+  transition: none;
+}
+
+.platform-android .upgrade-offer .island {
+  transition: background-color 0.15s ease-out;
+}
+
+.platform-android .upgrade-offer:active .island {
+  background-color: var(--press);
+}
+
+.platform-desktop .upgrade-offer:hover .island {
+  background-color: var(--hover-bg);
+}
+
+/* Before WebKit 16.2 the press is the grey as a veil over the cards' surface (components.css .island). */
+@supports not (color: color-mix(in srgb, red, red)) {
+  :is(.platform-ios, .platform-android) .upgrade-offer:active .island {
