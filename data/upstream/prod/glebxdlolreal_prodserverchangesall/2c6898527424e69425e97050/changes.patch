+    if (next.nodeType === 1) {
+
+      if (headingRegex.test(next.tagName)) {
+        // has txt
+        if (next.textContent && next.textContent.trim().length > 0) {
+          return false;
+        }
+        // no txt, ignore
+      }
+      // not header, check content
+      else if (ignoreTags.indexOf(next.tagName) === -1) {
+        // content
+        return true;
+      }
+    }
+
+    // txt node
+    else if (next.nodeType === 3) {
+      // non blnk
+      if (next.textContent && next.textContent.trim().length > 0) {
+        return true;
+      }
+    }
