+
+@media (-webkit-min-device-pixel-ratio: 1.5), (min-resolution: 1.5dppx) {
+  .star-cluster {
+    --star-px: 0.5px;
+  }
+}
+
+@media (-webkit-min-device-pixel-ratio: 2.5), (min-resolution: 2.5dppx) {
+  .star-cluster {
+    --star-px: calc(1px / 3);
+  }
+}
+
+.star-main,
+.star-part {
+  position: absolute;
+}
+
+.star-main {
+  top: -1.5px;
+  left: -1.5px;
+  width: 23px;
+  height: 23px;
+  background: url(../img/premiumbot/star-large.svg) 0 0 / 100% 100% no-repeat;
+}
+
+.star-part {
+  top: calc(2 * var(--star-px) - 1px);
+  left: calc(2px + var(--star-px) + (var(--i) - 1) * (3px - var(--star-px)));
+  width: calc(22px - 2 * var(--star-px));
+  height: calc(22px - 2 * var(--star-px));
+  background: url(../img/premiumbot/star-part.svg) 0 0 / 100% 100% no-repeat;
+}
+
+/* Open in Telegram, outside the client: no native buttons there. */
+.link-button {
+  display: inline-grid;
+  place-items: center;
+  min-height: 48px;
+  margin-top: var(--space-24);
+  padding: 0 var(--space-24);
+  border-radius: 12px;
+  background: var(--button);
+  color: var(--button-text);
+  font-weight: var(--fw-strong);
+}
+
+.theme-dark .toast {
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 4px 24px rgba(0, 0, 0, 0.24);
+}
