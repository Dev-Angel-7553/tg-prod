+      value      = $el.data('value') || 0,
+      next_value = value + (99 - value) / 4;
+  if (!value) {
+    $el.addClass('no-transition').css('width', 0);
+    $el.offset();
+    $el.removeClass('no-transition');
+  }
+  $el.data('to', to).data('value', next_value);
+  $el.removeClass('no-shown').css('width', value + '%');
