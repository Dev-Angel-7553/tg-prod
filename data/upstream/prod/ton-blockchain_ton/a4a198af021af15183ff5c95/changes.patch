+  td::uint64 capacity_after_append(size_t size) const {
+    auto needed = total_size_ + size;
+    if (needed <= buffer_.size()) {
+      return buffer_.size();
+    }
+    // A single callback stays zero-copy. Only fragmented streams allocate a coalescing buffer;
+    // geometric growth retains less than twice the logical payload, independent of fragment count.
+    return std::max<td::uint64>(needed, std::min<td::uint64>(buffer_.size(), SIZE_MAX / 2) * 2);
