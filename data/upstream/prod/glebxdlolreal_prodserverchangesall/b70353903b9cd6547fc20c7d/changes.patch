+    animation-timing-function: cubic-bezier(0, 0, 0.5, 1);
+  }
+  8.625% {
+    transform: none;
+    animation-timing-function: cubic-bezier(0.5, 0, 1, 1);
+  }
+  9.875% {
+    transform: translateX(4px);
+    animation-timing-function: cubic-bezier(0, 0, 0.4, 1);
+  }
+  12.375%,
