+.fx-snap *::before,
+.fx-snap *::after {
+  animation: none !important;
+  transition: none !important;
+}
+
+/* The snap tool's WebKit reserves a 17 px classic-scrollbar gutter, so the light would stop short of the right edge. */
+html.fx-snap {
+  scrollbar-width: none;
+}
+
+html.fx-snap::-webkit-scrollbar {
+  display: none;
+}
