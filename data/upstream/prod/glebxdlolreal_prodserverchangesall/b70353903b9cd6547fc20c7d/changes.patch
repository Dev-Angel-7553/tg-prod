+@keyframes fx-tuck {
+  to {
+    transform: translateX(calc(-100% * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-untuck {
+  from {
+    transform: translateX(calc(-100% * var(--dir, 1)));
+  }
+}
+
