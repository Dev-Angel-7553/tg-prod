+  void append(td::BufferSlice data, td::uint64 capacity) {
+    if (data.empty()) {
+      return;
+    }
+    auto old_capacity = buffer_.size();
+    if (buffer_.empty()) {
+      buffer_ = std::move(data);
+      total_size_ = buffer_.size();
+    } else {
