+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.cell-remove {
+  display: inline-grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  margin-inline-end: calc(-1 * var(--space-12));
+  color: var(--hint);
