+      }
+      buffer_.as_slice().substr(td::narrow_cast<size_t>(total_size_), data.size()).copy_from(data.as_slice());
+      total_size_ += data.size();
+    }
+    charge_.debit(buffer_.size() - old_capacity);
+  }
