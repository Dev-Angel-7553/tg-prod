+  align-self: stretch;
+  margin: var(--space-32) calc(-1 * var(--gutter)) 0;
+  text-align: start;
+}
+
+.result-rows .section {
+  margin-bottom: 0;
+}
+
+/* Stars */
+/* Inline amounts sit on the 20 px line: a 20 px glyph, top-aligned so the line box does not grow. The glyphs are
+   Telegram's shaded stars (Premium/Stars/StarSmall and StarLarge, in colour), not a tinted mask. */
+.stars {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  vertical-align: top;
+  white-space: nowrap;
+}
+
+.star-glyph {
+  width: 20px;
+  height: 20px;
+  background: url(../img/premiumbot/star-small.svg) center / contain no-repeat;
+  -webkit-mask: none;
+  mask: none;
+}
+
+/* The balance: rounded numerals (StarsBalanceComponent.swift, 48 rounded semibold). */
+.stars--big {
+  font-family: var(--font-rounded);
+  font-size: var(--fs-big);
+  font-weight: var(--fw-num);
+  line-height: var(--lh-big);
+  gap: var(--space-8);
+}
+
+.stars--big .star-glyph {
+  width: 40px;
+  height: 40px;
+  background-image: url(../img/premiumbot/star-large.svg);
+}
+
+.platform-android .stars--big .star-glyph {
+  width: 32px;
+  height: 32px;
+}
+
+/* Tier clusters, generateStarsIcon (StarsPurchaseScreen.swift): StarLarge in front, drawn 1.5 px over its 20 px box;
+   each next star painted over the last, 3 px less a device pixel further right (3 px for the first), in the tier
+   gradient, cut as Telegram cuts it (star-part.svg, tools/star-part.ts): what lies under a 1 px larger copy 2 px to
+   its left, and its left half below the top 4 px. Telegram counts in device pixels (UIScreenPixel), so each step lands
+   on one: --star-px is the screen's pixel. One file per star: composited mask layers render soft and uneven in
+   WebKit. The cut is transparent, so a cluster reads on any surface. */
+.star-cluster {
+  --star-px: 1px;
+  position: relative;
+  display: inline-block;
+  flex: none;
+  min-width: 40px;
+  height: 20px;
