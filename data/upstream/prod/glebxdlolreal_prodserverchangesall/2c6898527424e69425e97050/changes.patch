+  content: '';
+  position: absolute;
+  inset: calc(-1 * var(--space-24)) 0 0;
+  z-index: -2;
+  background: linear-gradient(
+    color-mix(in srgb, var(--page) 0%, transparent),
+    color-mix(in srgb, var(--page) 3.1%, transparent) 5px,
+    color-mix(in srgb, var(--page) 12.1%, transparent) 10px,
+    color-mix(in srgb, var(--page) 26.2%, transparent) 15px,
+    color-mix(in srgb, var(--page) 43.8%, transparent) 20px,
+    color-mix(in srgb, var(--page) 62.9%, transparent) 25px,
+    color-mix(in srgb, var(--page) 80.9%, transparent) 30px,
