+  gap: var(--space-8);
+  padding: var(--space-8) var(--space-16);
+  overflow-x: auto;
+  scrollbar-width: none;
+  -webkit-overflow-scrolling: touch;
+}
+
+.chips::-webkit-scrollbar {
+  display: none;
+}
+
+.chip {
+  position: relative;
+  display: inline-block;
+  flex: none;
+  padding-block: var(--space-4);
+  cursor: pointer;
+}
+
+.chip-face {
+  display: inline-grid;
+  place-items: center;
+  min-width: 48px;
+  height: 36px;
+  padding: 0 var(--space-16);
+  border-radius: 18px;
+  background: var(--fill);
+  font-weight: var(--fw-medium);
+  transition: background-color 0.15s ease-out, color 0.15s ease-out;
+}
+
+/* Selected: the tone's solid under white, as the chosen gift's price pill; selection draws no ring (design §11.8). */
+.cell-input:checked + .chip-face {
+  background: var(--tone-solid);
+  color: #fff;
+}
+
+.cell-input:focus-visible + .chip-face {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.platform-desktop .chip:hover .cell-input:not(:checked) + .chip-face {
+  background: var(--pressed);
+}
+
+/* Segmented control: two segments, full width, Telegram's SegmentedControlNode.swift: 32 px with a radius of 9, each
+   segment half of it, the thumb 2 px inside its segment with a radius of 8, labels 14 regular and semibold when
+   chosen. The thumb is a layer under the label, so the 2 px takes no padding and every box stays on the 4 px grid. */
+.segmented {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  margin: 0 var(--gutter) var(--section-gap);
+  border-radius: 9px;
+  background: var(--fill);
+}
+
+.segment {
+  position: relative;
+  display: block;
+  cursor: pointer;
+}
+
+.segment-face {
+  position: relative;
+  isolation: isolate;
+  display: grid;
+  place-items: center;
+  min-height: 32px;
+  padding: 0 var(--space-12);
+  font-size: var(--fs-segment);
+  font-weight: 400;
+  line-height: var(--lh-segment);
+}
+
+.segment-face::before {
+  content: '';
+  position: absolute;
+  inset: 2px;
+  z-index: -1;
+  border-radius: 8px;
+  transition: background-color 0.2s ease-out, box-shadow 0.2s ease-out;
+}
+
+/* A segment that is a link to its page has no input: it carries the state as .is-active and takes the focus itself. */
+.cell-input:checked + .segment-face,
+.segment.is-active .segment-face {
+  font-weight: var(--fw-strong);
+}
+
+.cell-input:checked + .segment-face::before,
+.segment.is-active .segment-face::before {
+  background: var(--thumb);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
+}
+
+.cell-input:focus-visible + .segment-face::before,
+.segment:focus-visible .segment-face::before {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.platform-android .segmented {
+  border-radius: 20px;
+}
+
+.platform-android .segment-face::before {
+  border-radius: 16px;
+}
+
+/* The tone's ink falls to 3.5:1 on its tint over the track (giveaways, Android light): a step more of the
+   text keeps 4.5:1. */
+.platform-android .cell-input:checked + .segment-face,
