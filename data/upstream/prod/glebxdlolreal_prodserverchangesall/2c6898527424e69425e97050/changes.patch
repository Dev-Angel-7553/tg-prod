+  --hover-bg: color-mix(in srgb, var(--island-surface), rgb(127 127 127) 10%);
+  border-radius: var(--island-radius);
+  background-color: var(--island-surface);
+  box-shadow: var(--island-shadow);
+}
+
+/* Section */
+.section {
+  margin: 0 var(--section-inset) var(--section-gap);
+}
+
+.section-header {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-8);
+  padding: 0 var(--space-16) var(--space-8);
+  color: var(--section-header);
+  font-size: var(--fs-section-header);
