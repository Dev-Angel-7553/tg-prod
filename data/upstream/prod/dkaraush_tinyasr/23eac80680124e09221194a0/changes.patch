+#[inline(always)]
+pub fn log_sum_exp(v: &[f32], m: f32) -> f32 {
+    let mut e = vec![0f32; v.len()];
+    vector(#[inline(always)] || e.iter_mut().zip(v).for_each(|(e, x)| *e = exp(x - m)));
+    m + e.iter().sum::<f32>().ln()
+}
