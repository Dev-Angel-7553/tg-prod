+
+/* Telegram's settings icon (PresentationResourcesSettings.swift renderSettingsIcon), in its order: the function's
+   colour, the Gradient sheen added to it, the Item List/Icons/Backdrop rim in overlay over both, a white glyph. The
+   30 px face is the padding box inside a clear 1 px border, so the 32 px box keeps layout on the 4 px grid. */
+.icon-tile {
+  position: relative;
+  display: inline-block;
+  flex: none;
+  width: var(--tile-box);
+  height: var(--tile-box);
+  border: calc((var(--tile-box) - var(--tile)) / 2) solid transparent;
+  border-radius: calc(var(--tile-radius) + (var(--tile-box) - var(--tile)) / 2);
+  background: var(--tile-color, var(--accent-fill)) padding-box;
+  color: #fff;
+  isolation: isolate;
+}
+
+.icon-tile::before,
+.icon-tile::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: var(--tile-radius);
+  pointer-events: none;
+}
+
+/* gradient.pdf: white at 14%, faded out from the top edge to the bottom one by a luminosity mask. */
+.icon-tile::before {
+  background: linear-gradient(rgb(255 255 255 / 0.14), rgb(255 255 255 / 0));
+  mix-blend-mode: plus-lighter;
+}
+
+.icon-tile::after {
+  background: url(../img/premiumbot/tile-backdrop.png) center / 100% 100% no-repeat;
+  mix-blend-mode: overlay;
+}
+
+.icon-tile .icon {
+  position: absolute;
+  z-index: 1;
+  inset: 0;
+  width: auto;
+  height: auto;
+}
+
+/* Text on a 2 px line step (13/18): a spacer after it, sized by gridSnap() in dom.ts, takes up the 2 px an odd line
+   count leaves, so the boxes after it stay on the 4 px grid (design §11.3). */
+.grid-snap::after {
+  content: '';
+  display: block;
+  height: var(--snap, 0px);
