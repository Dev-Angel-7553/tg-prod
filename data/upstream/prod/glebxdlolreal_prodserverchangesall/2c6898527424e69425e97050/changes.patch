+}
+
+.platform-android .upgrade-offer .island {
+  transition: background-color 0.15s ease-out;
+}
+
+.platform-android .upgrade-offer:active .island {
+  background-color: var(--press);
+}
+
+.platform-desktop .upgrade-offer:hover .island {
+  background-color: var(--hover-bg);
+}
+
+/* Before WebKit 16.2 the press is the grey as a veil over the cards' surface (components.css .island). */
+@supports not (color: color-mix(in srgb, red, red)) {
+  :is(.platform-ios, .platform-android) .upgrade-offer:active .island {
+    background-image: linear-gradient(var(--pressed), var(--pressed));
+  }
+
+  .platform-desktop .upgrade-offer:hover .island {
+    background-image: linear-gradient(var(--hover), var(--hover));
+  }
+}
+
+/* Settings: the external-link glyph as a row's value, as tall as the glyph, not its text line. */
+.settings .cell-value {
+  display: inline-flex;
+  align-items: center;
+  overflow-wrap: break-word;
+  overflow-wrap: anywhere;
+}
+
+/* "Turn Off Auto-Renewal" sits 40 px below the last section; the margins collapse into one. */
+.section.sub-quiet {
+  margin-top: 40px;
+}
+
+/* Stop flow: the field under the chosen reason, with its "Optional" hint. */
+.stop-details {
+  position: relative;
+}
+
+/* Under the reason's text, as the radio rows' separators are. */
+.stop-details::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  inset-inline: 52px 0;
+  height: 0.5px;
+  background: var(--separator);
+}
+
+/* Under the reason's text: the cell's 16 px, the 24 px check and the 12 px gap. */
+.stop-details .field {
+  padding-block: 0;
+  padding-inline-start: 52px;
+}
+
+/* An inset box, so the four empty lines read as one field and the hint under it as its caption. */
+.stop-details .field textarea {
+  padding: var(--space-8) var(--space-12);
+  border-radius: var(--space-12);
+  background: var(--fill);
+}
+
+/* The field's caption, in the reasons' column and 8 px under the field, as a footer under its island. */
+.stop-details-hint {
+  display: block;
+  padding: var(--space-8) var(--space-16) var(--space-12) 52px;
+  color: var(--secondary-text);
+  font-size: var(--fs-small);
+  line-height: var(--lh-small);
+}
+
+/* Results and the resume success: the stage fills the screen (design §11), nothing scrolls under it. A rule each:
+   WebKit before 15.4 drops a selector list whole for a :has() in it. */
+.screen[data-route='result'] {
+  padding-bottom: 0;
+}
+
+.screen:has(.fx-stage--fill) {
+  padding-bottom: 0;
+}
+
+/* In-page call to action (paywall_cta = custom; src/ui/components/cta.ts): Telegram's Premium pill (fx.css) in a bar
+   that sticks to the page bottom over the safe area, 48 px on the grid, with the screen's third light under it
+   (design §11.9). The bar brings its own bottom room, so the screen drops its padding. */
+.screen:has(.cta-bar:not([hidden])) {
+  padding-bottom: 0;
+}
+
+.cta-bar {
+  position: sticky;
+  bottom: 0;
+  z-index: 2;
