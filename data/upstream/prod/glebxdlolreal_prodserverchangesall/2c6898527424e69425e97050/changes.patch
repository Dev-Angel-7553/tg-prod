+/* Premium Bot Mini App: theme-aware, responsive, no preprocessor. */
+:root {
+  --pm-accent: #8774e1;
+  --pm-accent-strong: #735bd1;
+  --pm-accent-soft: rgba(135, 116, 225, 0.12);
+  --pm-card: #ffffff;
+  --pm-page: var(--tg-theme-bg-color, #f4f4f5);
+  --pm-section: var(--tg-theme-section-bg-color, var(--pm-card));
+  --pm-text: var(--tg-theme-text-color, #18212b);
+  --pm-hint: var(--tg-theme-hint-color, #708090);
+  --pm-link: var(--tg-theme-link-color, #4e46b8);
+  --pm-border: var(--tg-theme-section-separator-color, rgba(20, 32, 48, 0.1));
+  --pm-danger: #e55353;
+  --pm-shadow: 0 8px 30px rgba(24, 20, 66, 0.08);
+}
+
+html, body {
+  background: var(--pm-page);
+  color: var(--pm-text);
+}
+
+body {
+  margin: 0;
+  min-height: var(--tg-viewport-stable-height, 100vh);
+  -webkit-tap-highlight-color: transparent;
+}
+
+.pm-app {
+  box-sizing: border-box;
+  width: 100%;
+  max-width: 580px;
+  min-height: var(--tg-viewport-stable-height, 100vh);
+  margin: 0 auto;
+  padding: calc(14px + var(--tg-safe-area-inset-top, 0px)) 16px calc(30px + var(--tg-content-safe-area-inset-bottom, 0px));
+  color: var(--pm-text);
+}
+
+.pm-app *, .pm-app *::before, .pm-app *::after {
+  box-sizing: border-box;
+}
+
+.pm-hero {
+  position: relative;
+  overflow: hidden;
+  margin-bottom: 18px;
+  padding: 30px 24px 26px;
+  border-radius: 28px;
+  background:
+    radial-gradient(circle at 88% 2%, rgba(255, 255, 255, 0.3), transparent 34%),
+    linear-gradient(145deg, #a18cf1 0%, #8268d9 43%, #ac5db0 100%);
+  color: #ffffff;
+  text-align: center;
+  box-shadow: 0 15px 40px rgba(104, 76, 179, 0.2);
+}
+
+.pm-hero::after {
+  position: absolute;
+  right: -35px;
+  bottom: -70px;
+  width: 160px;
+  height: 160px;
+  border: 28px solid rgba(255, 255, 255, 0.08);
+  border-radius: 50%;
+  content: '';
+  pointer-events: none;
+}
+
+.pm-hero-art {
+  position: relative;
+  width: 120px;
+  height: 120px;
+  margin: 0 auto 8px;
+  animation: pm-hero-in 420ms cubic-bezier(.2,.8,.2,1) both;
+}
+
+.pm-svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  background-color: currentColor;
+  -webkit-mask-position: center;
+  mask-position: center;
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+  -webkit-mask-size: contain;
+  mask-size: contain;
+}
+
+.pm-hero-art > .pm-svg {
+  width: 104px;
+  height: 104px;
+  margin: 8px auto;
+  color: #ffffff;
+  filter: drop-shadow(0 10px 18px rgba(42, 25, 94, 0.22));
+}
+
+.pm-lottie-canvas {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+
+.pm-title {
+  position: relative;
+  margin: 4px 0 8px;
+  color: inherit;
+  font-size: 30px;
+  font-weight: 750;
+  line-height: 1.18;
+  letter-spacing: -0.02em;
+  outline: none;
+}
+
+.pm-subtitle {
+  position: relative;
+  max-width: 400px;
+  margin: 0 auto;
+  color: rgba(255, 255, 255, 0.88);
