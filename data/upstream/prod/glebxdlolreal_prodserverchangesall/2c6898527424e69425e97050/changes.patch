+  if ($.isArray(lang_value) ||
+      $.isPlainObject(lang_value)) {
+    html += '<span class="pluralized' + rtl_class + '">';
+    for (var p = 0; p < 6; p++) {
+      if (typeof lang_value[p] === 'undefined') continue;
