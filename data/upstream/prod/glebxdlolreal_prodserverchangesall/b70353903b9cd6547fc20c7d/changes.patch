+}
+
+/* WebKit before 16.2 can mix neither the wash and the pools nor their falloff, and a field holding a mix would take
+   the core down with it: the core shines alone there. */
+@supports not (color: color-mix(in srgb, red, red)) {
+  :is(.fx-stage, .fx-light__stage)::after {
+    --fx-wash: transparent;
+    --fx-pool-from: transparent;
+    --fx-pool-to: transparent;
+    --fx-field: none;
+  }
+}
+
+/* On dark the accent adds light. The core falls off on (1 − t²)², sampled every 10 %, from 0.42 at the centre to none
+   with no slope left, so no disc or rim shows round the mark. */
+.fx-stage--dark::after {
+  --fx-core: radial-gradient(calc(150px * var(--fx-scale)) calc(120px * var(--fx-scale)) at 50% var(--fx-y),
+    rgb(var(--fx-accent) / 0.42), rgb(var(--fx-accent) / 0.412) 10%, rgb(var(--fx-accent) / 0.387) 20%, rgb(var(--fx-accent) / 0.348) 30%,
+    rgb(var(--fx-accent) / 0.296) 40%, rgb(var(--fx-accent) / 0.236) 50%, rgb(var(--fx-accent) / 0.172) 60%, rgb(var(--fx-accent) / 0.109) 70%,
+    rgb(var(--fx-accent) / 0.054) 80%, rgb(var(--fx-accent) / 0.015) 90%, rgb(var(--fx-accent) / 0));
+  mix-blend-mode: plus-lighter;
+}
+
+/* Dark Stars: the star sits in darkness, as on Telegram's own Stars screen, whose scene has no light behind it
+   (StarsPurchaseScreen.swift, PremiumStarComponent with no backgroundColor). Its light is a bloom of its own
+   silhouette (.fx-stage__bloom below), and the sparkles carry the rest. */
+.fx-stage--dark.fx-stage--stars::after {
+  background: none;
+}
+
+/* Status screens: the 88 px mark and a glow scaled with it; src/fx/stage.ts thins the
+   field to the mark's area. */
+.fx-stage--compact {
+  --fx-mark: 88px;
+  --fx-scale: 0.7333;
+}
+
+/* A failure's glyph gets no light. */
+.fx-stage--bare::after {
+  content: none;
+}
+
+/* A full-screen stage fills the viewport under the top safe areas #app pads for (base.css), so the page ends at the
+   viewport's end and does not scroll by their height. */
+.fx-stage--fill {
+  --fx-fill-top: 0.12;
+  --fx-fill-height: calc(var(--tg-viewport-stable-height, 100vh) - var(--tg-safe-area-inset-top, 0px) - var(--tg-content-safe-area-inset-top, 0px));
+  min-height: var(--fx-fill-height);
+}
+
+/* A full-screen stage (results, full-screen states) starts its block at 12 % of the viewport at least, 16 px at the
+   least, so what follows the hero has room under it; src/fx/stage.ts lowers a short one to sit a little above the
+   middle. Where CSS can round, the block and the stage's end sit on the grid. A result starts at 6 %, so its list ends
+   above the MainButton. */
+.fx-stage--result {
+  --fx-fill-top: 0.06;
+}
+
+/* A short window, Telegram Desktop's 596 px or an iPhone mini's, cannot hold the prepaid giveaway 24 px above the
+   MainButton under the 120 px mark. Its result takes the 88 px mark of secondary screens,
+   capping the size a Lottie hero sets inline, and starts 24 px under the header, the stage's 16 and the hero's 8. */
+@media (max-height: 640px) {
+  .fx-stage--result {
+    --fx-fill-top: 0;
+    --fx-mark: 88px;
+    --fx-scale: 0.7333;
+  }
+
+  .fx-stage--result .hero-media > .lottie {
+    max-width: var(--fx-mark);
+    max-height: var(--fx-mark);
+  }
+}
+
+/* A result's last list ends the page 16 px above the MainButton (design §11.3): it drops its section gap and its block
+   its 24 px, and the block hangs 8 px into the stage's 24 px bottom padding, so a list that runs past the screen
+   scrolls no further, while src/fx/stage.ts still centres a short one over the full 24 px. The gap would count as room
+   there and lower a list that already overflows. */
+.fx-stage--result .stage-content--fill {
+  padding-bottom: 0;
+  margin-bottom: -8px;
+}
+
+.fx-stage--result .stage-content > .section:last-child {
+  margin-bottom: 0;
+}
+
+.fx-stage--fill .fx-stage__content {
+  justify-content: flex-start;
+  padding-top: max(16px, calc(var(--tg-viewport-stable-height, 100vh) * var(--fx-fill-top)));
+}
+
+@supports (padding-top: round(down, 100vh, 4px)) {
+  .fx-stage--fill {
+    min-height: round(down, var(--fx-fill-height), 4px);
+  }
+
+  .fx-stage--fill .fx-stage__content {
+    padding-top: max(16px, round(down, calc(var(--tg-viewport-stable-height, 100vh) * var(--fx-fill-top)), 4px));
+  }
+}
+
+/* A full-screen stage with its hero alone (a failure, a done state) centres it a little above the
+   middle, over 8 % of the viewport; src/fx/stage.ts sets the top padding. */
+.fx-stage--solo .fx-stage__content {
+  padding-top: 16px;
+  padding-bottom: max(24px, calc(var(--tg-viewport-stable-height, 100vh) * 0.08));
+}
+
+@supports (padding-bottom: round(down, 100vh, 4px)) {
+  .fx-stage--solo .fx-stage__content {
+    padding-bottom: max(24px, round(down, calc(var(--tg-viewport-stable-height, 100vh) * 0.08), 4px));
+  }
+}
+
+/* The particle field (src/fx/particles.ts): the stage's width, twice the mark tall, over the glow and under the hero.
+   src/fx/stage.ts sets its top and height. Its lower part fades out above the title, so no sparkle sits behind text. */
+.fx-stage__field {
+  position: absolute;
+  left: 0;
+  z-index: 1;
+  width: 100%;
+  -webkit-mask-image: linear-gradient(#000 60%, transparent 82%);
+  mask-image: linear-gradient(#000 60%, transparent 82%);
+  pointer-events: none;
+}
+
+.fx-stage__content {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  padding: 16px 0 24px;
+}
+
+/* The mark's box; the canvas around it is half as large again, as the icon fills two thirds of its view. */
+.fx-stage__hero {
+  position: relative;
+  flex: none;
+  width: var(--fx-mark);
+  height: var(--fx-mark);
+  margin: 8px auto;
+}
+
+:is(.hero, .result) > .fx-stage__hero {
+  margin: 0 0 16px;
+}
+
+.fx-stage__gl {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: calc(var(--fx-mark) * 1.5);
+  height: calc(var(--fx-mark) * 1.5);
+  transform: translate(-50%, -50%);
+  /* Horizontal drags spin the icon; vertical ones still scroll the page. */
+  touch-action: pan-y;
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* Dark Stars' light: a bloom of the golden star's own silhouette behind it, the Premium star blurred
+   twice in the particles' gold (star-bloom.svg, tools/star-part.ts starBloom), which src/fx/stage.ts turns with the 3D
+   star every frame. A transform only: the blur is painted once. Half the gold at the star's edge at most, spent about
+   20 px out, so the page beside the star stays black. Not with the flat glyph, whose star is another shape. */
+.fx-stage__bloom {
+  display: none;
+}
+
+.fx-stage--dark.fx-stage--stars:not(.fx-stage--flat) .fx-stage__bloom {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: block;
+  width: calc(var(--fx-mark) * 1.488);
+  height: calc(var(--fx-mark) * 1.488);
+  background: url(../img/premiumbot/star-bloom.svg) center / 100% 100% no-repeat;
+  transform: translate(-50%, -50%);
+  mix-blend-mode: plus-lighter;
+  pointer-events: none;
+  will-change: transform;
+}
+
+/* Without WebGL: Telegram's Premium glyph in the brand gradient, or the Star in gold. */
+.fx-stage--flat .fx-stage__gl {
+  display: none;
+}
+
+.fx-stage--flat .fx-stage__hero::before {
+  content: '';
+  position: absolute;
+  inset: 4%;
+  background: var(--brand-gradient);
+  -webkit-mask: url(../img/premiumbot/ui-premium.svg) center / contain no-repeat;
+  mask: url(../img/premiumbot/ui-premium.svg) center / contain no-repeat;
+}
+
+.fx-stage--flat.fx-stage--stars .fx-stage__hero::before {
+  background: var(--stars-gold);
+  -webkit-mask-image: url(../img/premiumbot/ui-star.svg);
+  mask-image: url(../img/premiumbot/ui-star.svg);
+}
+
+/* Gift: the recipients in the mark's place inside the field, as GiftAvatarComponent.swift:378-411 lays them out: one
+   avatar at 100 px, more at 60 px, each cut 2 px around the one before. Telegram steps them 30 apart (:397), which
+   halves an initial; 44 keeps it whole. */
+.fx-stage__hero--peer :is(.fx-stage__gl, .fx-stage__bloom),
+.fx-stage__hero--peer::before {
+  visibility: hidden;
+}
+
+/* In the status mark's place the slot grows to one recipient's 100 px avatar, so it keeps its 16 px to the title;
+   several, at 60 px, fit the 88 px slot. */
+.fx-stage--compact .fx-stage__hero--peer:has(> .avatar-stack > .avatar:only-child) {
+  --fx-mark: 100px;
+}
+
+.fx-stage__hero > .avatar-stack {
+  position: absolute;
+  inset: 0;
+  height: auto;
+  margin: 0;
+}
+
+.fx-stage__hero > .avatar-stack > * + * {
+  margin-inline-start: -16px;
+  -webkit-mask-image: radial-gradient(circle at -14px 50%, transparent 32px, #000 32.5px);
+  mask-image: radial-gradient(circle at -14px 50%, transparent 32px, #000 32.5px);
+}
+
+[dir='rtl'] .fx-stage__hero > .avatar-stack > * + * {
+  -webkit-mask-image: radial-gradient(circle at 74px 50%, transparent 32px, #000 32.5px);
+  mask-image: radial-gradient(circle at 74px 50%, transparent 32px, #000 32.5px);
+}
+
+.fx-stage__hero > .avatar-stack > .avatar-stack-more {
+  width: 60px;
+  height: 60px;
+}
+
+/* The stage's text follows the theme: these rules win over screen styles that set white text with two classes. */
+.fx-stage:not(.fx-stage--dark) {
+  color: var(--text);
+}
+
+.fx-stage .hero-title,
+.fx-stage:not(.fx-stage--dark) :is(.hero-title, .result-title, .hero-subtitle b) {
+  color: var(--text);
+}
+
+.fx-stage .hero-subtitle,
+.fx-stage:not(.fx-stage--dark) :is(.hero-subtitle, .result-text) {
+  color: var(--secondary-text);
+}
+
+/* First on a screen, the stage pulls up under the screen's top padding and fills the overscroll above it; its light
+   runs up past its box under the safe areas #app pads for (base.css), so in fullscreen the field starts on the page's
+   first row, under the status bar, while the boxes stay on the grid. Banners never sit above a stage
+   (src/ui/shell.ts), so only an empty banner slot may come before it. */
+.screen > :first-child > .fx-stage:first-child,
+.screen > .fx-stage:first-child,
+.screen-banner:empty + * > .fx-stage:first-child,
+.screen-banner:empty + .fx-stage {
+  margin-top: -16px;
+}
+
+.screen > :first-child > .fx-stage:first-child,
+.screen > .fx-stage:first-child,
+.screen-banner:empty + * > .fx-stage:first-child,
+.screen-banner:empty + .fx-stage,
+.fx-light__stage--first {
+  --fx-lift: calc(var(--tg-safe-area-inset-top, 0px) + var(--tg-content-safe-area-inset-top, 0px));
+}
+
+.screen > :first-child > .fx-stage:first-child::before,
+.screen > .fx-stage:first-child::before,
+.screen-banner:empty + * > .fx-stage:first-child::before,
+.screen-banner:empty + .fx-stage::before,
+.fx-light__stage--first::before {
+  top: -100vh;
+  background: linear-gradient(var(--fx-top) 100vh, var(--page));
+}
+
+/* The light field (src/fx/field.ts, design.md §11.9): in the app the stages' colour and light and the page's fireflies
+   are one layer behind the pages, which move over it, so the stages paint none of their own. Each .fx-light is the
+   light of one page: its parts sit where the page's stages, sheets and aura card are, in its tone, over the page
+   colour, so one light fades in over another wholly. A fine static grain over it breaks the 8-bit steps of its long,
+   dark gradients: black and white noise at --light-grain-a, about one level either way, one device pixel at 2x, never
+   animated. Two tiles of coprime sizes, so it repeats nowhere on a screen. The server prints the layer before any
+   script runs, so the field has the first screen's height from the first paint; premiumbot-fx.js then gives the
+   layer and its parts their places from the page. */
+#app > .fx-env {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+}
+
+/* A page with no stage has no stage light, and one with no sheet no fireflies: what the server printed for them
+   stays out of the first paint, until the script removes it. */
+#app:not(:has(.fx-stage)) .fx-light__stage,
+#app:not(:has(.fx-sheet, .neon-field)) .fx-light__flies {
+  display: none;
+}
+
+/* A bare stage has no light. The server names the stage so and not its light's part, which stays dark in the first
+   paint, until the script names the part after its stage. */
+#app:has(.fx-stage--bare) .fx-light__stage::after {
+  content: none;
+}
+
+.fx-light {
+  position: absolute;
+  right: 0;
+  left: 0;
+  isolation: isolate;
+  background: var(--page);
+}
+
+:is(.fx-light__stage, .fx-light__flies) {
+  position: absolute;
+}
+
+.fx-light::after {
+  content: '';
+  position: absolute;
+  inset: -100vh 0 0;
+  background:
+    url(../img/premiumbot/grain.png) 0 0 / 64px 64px,
+    url(../img/premiumbot/grain.png) 29px 13px / 61px 61px;
+  opacity: var(--light-grain-a);
+  image-rendering: pixelated;
+}
+
+.screens .fx-stage::before,
+.screens .fx-stage::after {
+  content: none;
+}
+
+/* The fireflies (src/fx/fireflies.ts, design.md §11.9): the page's light under the islands. Each is the tone's colour
+   down the stage light's eased falloff, painted once; down the page its hue runs from --fly-from to --fly-to. Dark
+   Stars and giveaways add their light to the page (--fly-blend: plus-lighter), so it lights any bg_color; Premium's
+   rise to about the cells' luminance, and in light all lie a hair under the page's. Their part runs from
+   the first sheet's top to the page's end and clips them there, so they never add to the scroll, and its mask spends
+   whatever reaches its edges. Where the engine has scroll-driven animations they ride the document's scroll, each a
+   share of every px (FLY_RANGE); elsewhere fireflies.ts writes the same transform in a frame. A page out of the flow
+   holds them where its scroll left them (.is-held); reduced motion and snap mode keep them still. */
+.fx-light__flies {
+  overflow: hidden;
+  -webkit-mask: linear-gradient(transparent, #000 48px, #000 calc(100% - 96px), transparent);
+  mask: linear-gradient(transparent, #000 48px, #000 calc(100% - 96px), transparent);
+  mix-blend-mode: var(--fly-blend);
+}
+
+.fx-fly {
+  position: absolute;
+  background: radial-gradient(closest-side, var(--fly-c), color-mix(in srgb, var(--fly-c) 92%, transparent) 20%,
+    color-mix(in srgb, var(--fly-c) 71%, transparent) 40%, color-mix(in srgb, var(--fly-c) 41%, transparent) 60%,
+    color-mix(in srgb, var(--fly-c) 13%, transparent) 80%, transparent);
+  will-change: transform;
+}
+
+@supports (animation-timeline: scroll()) and (animation-range: 0 1px) {
+  .fx-fly {
+    animation: fx-fly 1ms linear both;
+    animation-timeline: scroll(root);
+    animation-range: 0 10000px;
+  }
+}
+
+.fx-light__flies.is-held > .fx-fly,
+.fx-reduce .fx-fly {
+  animation: none;
+}
+
+.fx-reduce .fx-fly {
+  will-change: auto;
+}
+
+@keyframes fx-fly {
+  from {
+    transform: translate(0, 0) scale(1);
+  }
+  to {
+    transform: translate(var(--fly-dx), var(--fly-dy)) scale(var(--fly-k));
+  }
+}
+
+/* A banner on a screen with a stage but no sheet sits right under the stage. */
+.fx-stage + .screen-banner {
+  padding-top: 16px;
+}
+
+/* Results: 24 px under the hero's subtitle, what
+   the purchase did, in sections: Premium a row to all its features, a gift its recipients with what each got, a
+   giveaway its chat, winners and prize. Stars shows the new balance as the Stars screen does: the 48 px rounded
+   numeral, 8 px over "Your balance"; then, as for Stars sent and a Stars giveaway, what Stars do. */
+.result-balance {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  margin-bottom: var(--section-gap);
+}
+
+/* What Stars do, as StarsIntroScreen.swift:126-190 lists it: Telegram's 30 px glyph in the accent where a feature row
+   has its tile, the title, the text at 15/20 in the hint colour. */
+.result-perk .cell-lead {
+  position: relative;
+  width: var(--tile-box);
+  height: var(--tile-box);
+  color: var(--tone-ink);
+}
+
+.result-perk .cell-lead .icon {
+  position: absolute;
+  inset: calc((var(--tile-box) - var(--tile)) / 2);
+  width: auto;
+  height: auto;
+}
+
+.result-perk .cell-subtitle {
+  color: var(--secondary-text);
+  font-size: var(--fs-sub);
+  line-height: var(--lh-sub);
+}
+
+.result-balance-label {
+  margin-top: var(--space-8);
+  color: var(--secondary-text);
+  font-size: var(--fs-sub);
+  line-height: var(--lh-sub);
+}
+
+/* A name in a result's text that links takes the link's ink a step towards the text: the stage's light behind it is
+   brighter than the page and would hold the violet ink under 4.5:1. That close to the text, a hairline under it tells
+   it from a bold name without a link, which has none. */
+.fx-stage--result .hero-subtitle a {
+  color: color-mix(in srgb, var(--link) 60%, var(--text));
+  text-decoration-line: underline;
+  text-decoration-thickness: 1px;
+  text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
+  text-underline-offset: 3px;
+}
+
+/* A failure's glyph on its disc (src/ui/components/result.ts errorLayout). */
+.result-media--error {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 56px;
+  height: 56px;
+  border-radius: 50%;
+  color: var(--destructive);
+  background: color-mix(in srgb, var(--destructive) 12%, transparent);
+}
+
+/* The content after a stage rises over it, and over the stage's field and content layers. It paints no page of its
+   own, so the stage's light ends on the page itself, with no sheet edge (design.md §11.9). */
+.fx-sheet {
+  position: relative;
+  z-index: 1;
+  margin-top: -24px;
+  padding-top: 8px;
+}
+
+/* The entrance (src/fx/effects.ts stagger): a sheet's blocks rise 8 px and fade in over 320 ms, 30 ms apart over at
+   most eight steps, from the page's first paint; none under reduced motion. The aura's light is no block of its own:
+   premiumbot-fx.js gives it its card's entrance. */
+@media (prefers-reduced-motion: no-preference) {
+  .fx-sheet > :not(.neon-aura__light) {
+    animation: fx-stagger 320ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
+  }
+
+  .fx-sheet > :nth-child(2 of :not(.neon-aura__light)) {
+    animation-delay: 30ms;
+  }
+
+  .fx-sheet > :nth-child(3 of :not(.neon-aura__light)) {
+    animation-delay: 60ms;
+  }
+
+  .fx-sheet > :nth-child(4 of :not(.neon-aura__light)) {
+    animation-delay: 90ms;
+  }
+
+  .fx-sheet > :nth-child(5 of :not(.neon-aura__light)) {
+    animation-delay: 120ms;
+  }
+
+  .fx-sheet > :nth-child(6 of :not(.neon-aura__light)) {
+    animation-delay: 150ms;
+  }
+
+  .fx-sheet > :nth-child(7 of :not(.neon-aura__light)) {
+    animation-delay: 180ms;
+  }
+
+  .fx-sheet > :nth-child(n + 8 of :not(.neon-aura__light)) {
+    animation-delay: 210ms;
+  }
+}
+
+@keyframes fx-stagger {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.fx-burst {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+
+.fx-confetti {
+  position: fixed;
+  inset: 0;
+  z-index: 3;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+
+.fx-count {
+  font-variant-numeric: tabular-nums;
+}
+
+/* Press and lift share one transform so they compose: tiles and cards go to 0.97 in 120 ms and back in 240 ms,
+   without overshoot. Rows only highlight (components.css .is-tappable). The lift has a name of its own: an element on
+   a first stage would inherit the stage's --fx-lift, the safe areas. */
+.fx-press {
+  transform: translate(0, var(--fx-press-lift, 0px)) scale(var(--fx-s, 1));
+  transition:
+    transform 240ms ease-out,
+    box-shadow 220ms ease-out;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.fx-press.is-pressed {
+  --fx-s: 0.97;
+  transition-duration: 120ms;
+}
+
+.cell.fx-press.is-pressed {
+  --fx-s: 1;
+}
+
+/* The custom CTA is Telegram's Premium button (PremiumIntroScreen.swift:3919-3960): a 52 px pill, the label 17/20
+   600 white, the amount its second line at 11/16 500, pressed at 80 %. Its skin takes the stops of :3920-3925,
+   darkened in OKLab so white text keeps 4.5:1, drifting over 2.4 × its width, 4.5 s each way (ButtonComponent.swift
+   :1097-1200); over it runs the shimmer of Telegram's purchase buttons (ButtonComponent.swift:1204-1258,
+   ShimmerEffect.swift:143-160): a 70 px band of white at 0.5 and a 1.5 px ring in overlay, crossing in 410 ms. The
+   glow below is its one light: no shadow, no rim. While lit and pressable it beckons once a breath on the light clock
+   (src/fx/light.ts), in one beat with Best Value's glint: it swells from the breath's peak, as the sparkle flares, and
+   its shine sets off 200 ms on, as the light leaves the sparkle, with two knocks of the arrow (below), instead of the
+   native sweep every 4 s. Only transforms and opacity move; unlit, under reduced motion and in snap mode it rests,
+   with no band. */
+.cta-button.cta-button--premium {
+  flex-direction: column;
+  min-height: 52px;
+  border-radius: 26px;
+  background: transparent;
+  box-shadow: none;
+  /* The grey of the inactive pill stays until the skin has faded back in over it. */
+  transition:
+    opacity 240ms ease-out,
+    transform 240ms ease-out,
+    color 200ms ease-out,
+    background-color 0s 200ms;
+}
+
+.cta-button.cta-button--premium[aria-disabled='true'] {
+  transition-delay: 0s;
+}
+
+.cta-face,
+.cta-skin,
+.cta-ring {
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  pointer-events: none;
+}
+
+.cta-skin {
+  overflow: hidden;
+  transition: opacity 200ms ease-out;
+}
+
+.cta-skin::before {
+  content: '';
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 240%;
+  background: linear-gradient(90deg, #0070f7, #4c70d9, #7562e7, #be46aa);
+  transform: translateX(-20.83%);
+}
+
+.cta-skin::after,
+.cta-ring::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.5), rgb(255 255 255 / 0)) 0 0 / 70px 100% no-repeat;
+  transform: translateX(-70px);
+}
+
+.cta-skin::after {
+  mix-blend-mode: overlay;
+}
