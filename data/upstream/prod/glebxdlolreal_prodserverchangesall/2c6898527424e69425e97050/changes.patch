+/* ---------- FCM drop zone ---------- */
+.drop { position: relative; border-radius: 14px; background: var(--surface-2); border: 1.5px solid transparent; transition: border-color .2s ease, background-color .2s ease, transform .3s cubic-bezier(.16, 1, .3, 1), box-shadow .3s ease; }
