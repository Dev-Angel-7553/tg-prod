+        private static string FormatPrice(IClientService clientService, long nanograms)
+        {
+            var usd = GiftHelper.FormatUsd(clientService, nanograms);
+            return usd != null
+                ? GiftHelper.FormatGrams(nanograms) + " (" + usd + ")"
+                : GiftHelper.FormatGrams(nanograms);
