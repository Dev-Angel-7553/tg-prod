+
+  if (json.descHtml) {
+    var descRow = document.createElement('div');
+    descRow.className = 'graph_desc_row';
+    descRow.innerHTML = '<span class="graph_desc_text">' + json.descHtml + '</span>';
+    domEl.parentNode.insertBefore(descRow, domEl.nextSibling);
+  }
+
+  return chart;
+}
