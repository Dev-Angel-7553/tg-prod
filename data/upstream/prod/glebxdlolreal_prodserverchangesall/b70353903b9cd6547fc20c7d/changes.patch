+  margin: 0;
+}
+
+.cta-button--premium .cta-total {
+  margin: 0;
+  /* White, not Telegram's 70 %: on stops held to 4.5:1 for white, 70 % reads 3.1:1. */
+  color: #fff;
+  font-size: 11px;
+  font-weight: 500;
+  line-height: 16px;
+}
+
+.cta-button--premium[aria-disabled='true'] .cta-skin {
+  opacity: 0;
+}
+
+.cta-button--premium[aria-disabled='true'] .cta-total {
