+                    let v = _mm512_loadu_si512(w.add(b * 64) as *const _);
+                    let k0 = b * ks;
+                    let a8 = |r: usize, kk: usize| _mm512_set1_epi64((aq.add(r * k + kk) as *const i64).read_unaligned());
