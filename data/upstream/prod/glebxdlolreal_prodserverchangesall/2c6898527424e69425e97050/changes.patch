+          j: Math.floor(i / 10),
+          group_id: group_id,
+          index: index++,
+          emoji: emojis[i]
+        };
+        Aj.state.emojiHexList.push(hex);
+        if (hex.slice(-12) == 'e2808de29982' ||
+            hex.slice(-12) == 'e2808de29980') {
+          Aj.state.emojiByHex[hex.slice(0, -12)] = Aj.state.emojiByHex[hex];
