+                    for i in 0..8 {
+                        let v = byte(i);
+                        let wf = wv(if !INT4 { v } else if h == 0 { _mm_and_si128(_mm_slli_epi16::<4>(v), mask) } else { _mm_and_si128(v, mask) });
