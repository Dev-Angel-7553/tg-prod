+    #[target_feature(enable = "avx512f,avx512bw,avx512dq,avx512vl,avx2,fma")]
+    pub unsafe fn q8p_avx512<const R: usize, const P: usize>(a: *const f32, k: usize, q: *const i8, sc: *const f32, init: *const f32, o: *mut f32, stride: usize) {
