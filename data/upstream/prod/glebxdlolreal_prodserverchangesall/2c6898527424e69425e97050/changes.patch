+        }
+      },
+      error: function(xhr) {
+        if (xhr.status == 401) {
+          location.href = '/auth';
+        } else {
+          location.reload();
+        }
+      }
+    });
+    return false;
+  },
+  packFile: function(files, thumb, payload) {
+    for (var i = 0; i < files.length; i++) {
+      var file = files[i];
+      if (file.url) {
