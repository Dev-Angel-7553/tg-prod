+  }
+  if (absVal > 1) {
+    return 1;
+  }
+  return 2;
+}
+
+function statsChooseNumKMBT(val) {
+  var absVal = Math.abs(val);
+  if (absVal >= 1000000000000)   {
+    return 'T';
+  }
+  else if (absVal >= 1000000000) {
+    return 'B';
+  }
+  else if (absVal >= 1000000) {
+    return 'M';
+  }
+  else if (absVal >= 2000)  {
+    return 'K';
+  }
+  return '';
+}
