+    transform: none;
+    animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
+  }
+  5.625% {
+    transform: scale(1.03);
+    animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
+  }
+  16.5%,
+  100% {
+    transform: none;
+  }
+}
+
+/* The bloom rises with the swell and lingers a little after it. */
+@keyframes fx-cta-bloom {
+  0% {
+    opacity: 0;
+    animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
+  }
+  6.5% {
+    opacity: 1;
+    animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
+  }
