+
+/* As a .cell: one line with its tile is as tall as one without. */
+.skeleton-cell--tile {
+  padding-block: var(--space-4);
+}
+
+.skeleton-tile {
+  flex: none;
+  width: var(--tile-box);
+  height: var(--tile-box);
+  border-radius: var(--tile-radius);
+}
+
+/* The home's sketch takes each line the paywall home lands with (src/ui/components/skeleton.ts homeSkeleton), so the
+   first load shows no jump. The stage's 120 px mark, its title's line, then the subtitle 8 px under it:
+   two lines in iOS's 15 px, where the copy wraps, one in Android's 14 and desktop's 13. */
+.skeleton-hero--stage .skeleton-title {
+  height: calc(var(--fs-hero) * var(--lh-hero) - 8px);
