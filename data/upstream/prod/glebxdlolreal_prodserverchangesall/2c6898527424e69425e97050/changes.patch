+  }
+
+  .pm-cell, .pm-plan, .pm-chip, .pm-primary, .pm-secondary {
+    transition: none;
+  }
+
+  .pm-cell:active, .pm-plan:active, .pm-chip:active, .pm-primary:active, .pm-secondary:active {
+    transform: none;
+  }
+}
diff --git a/b-/premiumbot.js b/b-/premiumbot.js
@@ -0,0 +1,389 @@
+/* Premium Bot Mini App: plain classic JavaScript, no build step. */
+window.PremiumApp = (function() {
+  'use strict';
+
+  var POLL_INTERVAL = 1500;
+  var POLL_TIMEOUT = 120000;
+  var picker = null;
+  var pickerSequence = 0;
+  var mainAction = false;
+
+  function webApp() {
+    return window.Telegram && window.Telegram.WebApp;
+  }
+
+  function showMessage(text, isError) {
+    var element = document.getElementById('pm-message');
+    if (!element) {
+      return;
+    }
+    element.textContent = text;
+    element.className = isError ? 'pm-message pm-message-error' : 'pm-message';
+    element.hidden = false;
+    var live = document.getElementById('pm-live');
+    if (live) {
+      live.textContent = text;
+    }
+  }
+
+  function clearMessage() {
+    var element = document.getElementById('pm-message');
+    if (element) {
+      element.hidden = true;
+      element.textContent = '';
+    }
+  }
+
+  function setButtonBusy(button, busy) {
+    if (!button) {
+      return;
+    }
+    button.disabled = !!busy;
+    if (busy) {
+      button.classList.add('is-loading');
+    } else {
+      button.classList.remove('is-loading');
+    }
+  }
+
+  function openInvoice(url) {
+    var app = webApp();
+    if (!app || !url) {
+      return;
+    }
+    if (!app.isVersionAtLeast('6.1')) {
+      app.openTelegramLink(url);
+      return;
+    }
+    var buttons = document.querySelectorAll('.js-invoice');
+    var button = null;
+    for (var i = 0; i < buttons.length; i++) {
+      if (buttons[i].getAttribute('data-invoice-url') === url) {
+        button = buttons[i];
+        break;
+      }
+    }
+    setButtonBusy(button, true);
+    clearMessage();
+    try {
+      app.openInvoice(url, function(status) {
+        setButtonBusy(button, false);
+        if (status === 'paid') {
+          Aj.location('/premiumbot/result/paid');
+          return;
+        }
+        if (status === 'pending') {
+          showMessage('Payment is pending. Your selection is kept; please check again shortly.', false);
+          return;
+        }
+        if (status === 'failed') {
+          showMessage('Payment failed. You can retry with the same option.', true);
+          return;
+        }
+        showMessage('Payment was cancelled. Your selection is unchanged.', false);
+      });
+    } catch (error) {
+      setButtonBusy(button, false);
+      showMessage('Unable to open this invoice. Please try again.', true);
+    }
+  }
+
+  function fallbackToBot(flow, button) {
+    var app = webApp();
+    if (!app) {
+      return;
+    }
+    var username = window.Aj && Aj.state.botUsername ? Aj.state.botUsername : 'PremiumBot';
+    var baseUrl = 'https://t.me/' + username;
+    if (flow === 'gift') {
+      app.openTelegramLink(baseUrl + '?start=gift');
+      return;
+    }
+    var commands = {
+      stars_gift: '/stars',
+      premium_giveaway: '/giveaway',
+      stars_giveaway: '/stars_giveaway'
+    };
+    var command = commands[flow] || '/status';
+    var openBot = function() {
+      app.openTelegramLink(baseUrl);
+    };
+    if (app.isVersionAtLeast('6.2')) {
+      app.showPopup({
+        title: 'Continue in @' + username,
+        message: 'Send ' + command + ' to @' + username + ' to use this flow in the existing bot chat.',
+        buttons: [
+          {id: 'open', type: 'default', text: 'Open @' + username},
+          {id: 'cancel', type: 'cancel'}
+        ]
+      }, function(buttonId) {
+        if (buttonId === 'open') {
+          openBot();
+        }
+      });
+    } else {
+      var container = button ? button.closest('.pm-picker') : null;
+      var status = container ? container.querySelector('.pm-picker-status') : null;
+      if (status) {
+        status.textContent = 'Send ' + command + ' to @' + username + ' to use this flow in the existing bot chat.';
+        status.appendChild(document.createElement('br'));
+        var link = document.createElement('a');
+        link.href = baseUrl;
+        link.className = 'pm-secondary pm-link';
+        link.textContent = 'Open @' + username;
+        link.addEventListener('click', function(event) {
+          event.preventDefault();
+          openBot();
+        }, false);
+        status.appendChild(link);
+      } else {
+        openBot();
+      }
+    }
+  }
+
+  function pickerText(text, isError) {
+    if (!picker) {
+      return;
+    }
+    var container = picker.button ? picker.button.closest('.pm-picker') : null;
+    var status = container ? container.querySelector('.pm-picker-status') : null;
+    if (status) {
+      status.textContent = text;
+      status.classList.toggle('is-error', !!isError);
+    }
+    if (isError) {
+      showMessage(text, true);
+    }
+  }
+
+  function stopPicker() {
+    if (!picker) {
+      return;
+    }
+    picker.cancelled = true;
+    if (picker.timer) {
+      clearTimeout(picker.timer);
+    }
+    setButtonBusy(picker.button, false);
+    picker = null;
+  }
+
+  function finishPickerWithError(text) {
+    if (!picker) {
+      return;
+    }
+    pickerText(text, true);
+    stopPicker();
+  }
+
+  function schedulePoll(delay) {
+    if (!picker || picker.cancelled) {
+      return;
+    }
+    picker.timer = setTimeout(pollPeer, delay || POLL_INTERVAL);
+  }
+
+  function pollPeer() {
+    if (!picker || picker.cancelled || picker.inFlight) {
+      return;
+    }
+    if (Date.now() - picker.startedAt >= POLL_TIMEOUT) {
+      finishPickerWithError('Recipient selection timed out. Please try again.');
+      return;
+    }
+    var current = picker;
+    picker.inFlight = true;
+    Aj.apiRequest('getPeerRequest', {
+      flow: current.flow,
+      webapp_req_id: current.requestId
+    }, function(result) {
+      if (!picker || picker.serial !== current.serial || picker.cancelled) {
+        return;
+      }
+      picker.inFlight = false;
+      if (result.error === 'PEER_REQUEST_EXPIRED') {
+        finishPickerWithError('Recipient selection expired. Please start again.');
+        return;
+      }
+      if (result.error) {
+        finishPickerWithError('Unable to read the selection. Please try again.');
+        return;
+      }
+      if (result.status === 'ready' && result.url) {
+        var url = result.url;
+        stopPicker();
+        Aj.location(url);
+        return;
+      }
+      schedulePoll(POLL_INTERVAL);
+    });
+  }
+
+  function requestNativePeer() {
+    if (!picker || picker.cancelled) {
+      return;
+    }
+    var current = picker;
+    try {
+      webApp().requestChat(current.requestId, function(sent) {
+        if (!picker || picker.serial !== current.serial || picker.cancelled) {
+          return;
+        }
+        if (!sent) {
+          pickerText('Selection was cancelled.', false);
+          stopPicker();
+          return;
+        }
+        pickerText('Waiting for Telegram to share the selection…', false);
+        schedulePoll(POLL_INTERVAL);
+      });
+    } catch (error) {
+      fallbackToBot(current.flow, current.button);
+      stopPicker();
+    }
+  }
+
+  function startPicker(flow, chatType, button) {
+    var app = webApp();
+    if (!app) {
+      return;
+    }
+    if (!app.isVersionAtLeast('9.6')) {
+      fallbackToBot(flow, button);
+      return;
+    }
+    stopPicker();
+    clearMessage();
+    picker = {
+      flow: flow,
+      chatType: chatType || '',
+      button: button,
+      requestId: '',
+      startedAt: Date.now(),
+      serial: ++pickerSequence,
+      timer: null,
+      inFlight: false,
+      cancelled: false
+    };
+    var current = picker;
+    setButtonBusy(button, true);
+    pickerText('Preparing the Telegram picker…', false);
+    Aj.apiRequest('requestPeer', {
+      flow: flow,
+      chat_type: current.chatType
+    }, function(result) {
+      if (!picker || picker.serial !== current.serial || picker.cancelled) {
+        return;
+      }
+      if (result.error || !result.webapp_req_id) {
+        finishPickerWithError('Unable to prepare the Telegram picker. Please try again.');
+        return;
+      }
+      picker.requestId = result.webapp_req_id;
+      picker.startedAt = Date.now();
+      requestNativePeer();
+    });
+  }
+
+  function filterPlans(button) {
+    var group = button.parentNode;
+    var filters = group.querySelectorAll('.js-plan-filter');
+    for (var i = 0; i < filters.length; i++) {
+      filters[i].classList.toggle('is-active', filters[i] === button);
+    }
+    var constraints = {};
+    var rows = document.querySelectorAll('.pm-filters');
+    for (var r = 0; r < rows.length; r++) {
+      var active = rows[r].querySelector('.js-plan-filter.is-active');
+      if (active) {
+        var field = active.getAttribute('data-filter-field');
+        var value = active.getAttribute('data-filter-value');
+        if (value) {
+          constraints[field] = value;
+        }
+      }
+    }
+    var plans = document.querySelectorAll('.pm-plan');
+    for (var j = 0; j < plans.length; j++) {
+      var show = true;
+      for (var fieldName in constraints) {
+        if (Object.prototype.hasOwnProperty.call(constraints, fieldName) &&
+            plans[j].getAttribute('data-' + fieldName) !== constraints[fieldName]) {
+          show = false;
+        }
+      }
+      plans[j].hidden = !show;
+    }
+  }
+
+  function mainButtonHandler() {
+    if (mainAction === 'home') {
+      Aj.location('/premiumbot');
+    }
+  }
+
+  function bind(selector, eventName, handler) {
+    var elements = document.querySelectorAll(selector);
+    for (var i = 0; i < elements.length; i++) {
+      elements[i].addEventListener(eventName, handler, false);
+    }
+  }
+
+  function cleanup() {
+    stopPicker();
+    mainAction = false;
+    var app = webApp();
+    if (app && app.MainButton) {
+      app.MainButton.offClick(mainButtonHandler);
+      app.MainButton.hide();
+    }
+    if (window.PremiumLottie) {
+      window.PremiumLottie.destroy();
+    }
+  }
+
+  function init() {
+    cleanup();
+    var app = webApp();
+    if (app) {
+      app.setHeaderColor('bg_color');
+      app.setBackgroundColor('bg_color');
+    }
+    bind('.js-invoice', 'click', function() {
+      openInvoice(this.getAttribute('data-invoice-url'));
+    });
+    bind('.js-request-peer', 'click', function() {
+      startPicker(this.getAttribute('data-peer-flow'), this.getAttribute('data-peer-chat-type'), this);
+    });
+    bind('.js-telegram-link', 'click', function() {
+      var appInstance = webApp();
+      if (appInstance) {
+        appInstance.openTelegramLink(this.getAttribute('data-telegram-url'));
+      }
+    });
+    bind('.js-plan-filter', 'click', function() {
+      filterPlans(this);
+    });
+    if (window.location.pathname.indexOf('/premiumbot/result/') === 0 && app && app.MainButton) {
+      mainAction = 'home';
+      app.MainButton.setParams({text: 'BACK TO PREMIUM', is_visible: true});
+      app.MainButton.onClick(mainButtonHandler);
+    }
+    var title = document.querySelector('.pm-title');
+    if (title) {
+      title.focus();
+    }
+    if (window.PremiumLottie) {
+      window.PremiumLottie.mount(document);
+    }
+    Aj.onUnload(cleanup);
+  }
+
+  return {
+    init: init,
+    openInvoice: openInvoice,
+    startPicker: startPicker,
+    cleanup: cleanup
+  };
+})();
diff --git a/b-/promote-dark.css b/b-/promote-dark.css
@@ -0,0 +1,538 @@
+:root {
+  --pr-dark-bg-color: #1A2026;
+  --pr-dark-surface: #212A33;
+  --pr-dark-surface-hover: #293440;
+  --pr-dark-text-primary: #fff;
+  --pr-dark-text-secondary: #8794A1;
+  --pr-dark-text-accent: #4CB2FF;
+  --pr-dark-accent: #2392e7;
+  --pr-dark-accent-hover: #0b9dec;
+  --pr-dark-border: #293440;
+  --pr-dark-border-light: #3a4756;
+  --pr-dark-danger: #ef658f;
+  --pr-dark-warning: #f28c48;
+  --pr-dark-success: #5bad57;
+  --pr-dark-input-bg: #1A2026;
+  --pr-dark-input-shadow: #3a4756;
+  --pr-dark-input-focus: #35a3f6;
+  --pr-dark-overlay: rgba(0, 0, 0, 0.55);
+}
+
+@property --pr-theme-hole-radius {
+  syntax: '<length>';
+  inherits: false;
+  initial-value: 0px;
+}
+
+/* Floating toggle button (top-right, above header). */
+.pr-theme-toggle {
+  align-items: center;
+  background: transparent;
+  border: 0;
+  color: #8a939d;
+  cursor: pointer;
+  display: flex;
+  height: 50px;
+  justify-content: center;
+  opacity: 0.7;
+  padding: 0 16px;
+  position: fixed;
+  right: 77px;
+  top: 0;
+  transition: opacity 0.15s ease;
+  view-transition-name: pr-theme-toggle;
+  z-index: 1001;
+}
+.pr-theme-toggle:hover {
+  opacity: 1;
+}
+.pr-theme-toggle canvas,
+.pr-theme-toggle--static:before {
+  display: block;
+  height: 22px;
+  width: 22px;
+}
+.pr-theme-toggle--static canvas {
+  display: none;
+}
+.pr-theme-toggle--static:before {
+  content: '';
+  background-size: contain;
+  background-image: url('/img/themeMoon.webp');
+}
+@media (min-width: 768px) {
+  .pr-theme-toggle {
+    right: 0;
+  }
+}
+
+html.pr-theme-switching body,
+html.pr-theme-switching body * {
+  transition: none !important;
+}
+
+::view-transition-group(root) {
+  isolation: isolate;
+  overflow: hidden;
+}
+::view-transition-image-pair(root) {
+  isolation: auto;
+  overflow: hidden;
+}
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+::view-transition-old(root) {
+  z-index: 9999;
+  will-change: clip-path;
+  transform: translateZ(0);
+}
+::view-transition-new(root) { z-index: 1; }
+
+:root.pr-theme-reveal::view-transition-old(root) {
+  z-index: 9999;
+  transform: none;
+  will-change: auto;
+  -webkit-mask-image: radial-gradient(
+    circle at var(--pr-theme-origin-x) var(--pr-theme-origin-y),
+    transparent 0,
+    transparent var(--pr-theme-hole-radius),
+    #000 calc(var(--pr-theme-hole-radius) + 1px)
+  );
+  mask-image: radial-gradient(
+    circle at var(--pr-theme-origin-x) var(--pr-theme-origin-y),
+    transparent 0,
+    transparent var(--pr-theme-hole-radius),
+    #000 calc(var(--pr-theme-hole-radius) + 1px)
+  );
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+  mask-mode: alpha;
+}
+:root.pr-theme-reveal::view-transition-new(root) { z-index: 1; }
+
+/* Theme toggle icon morph animation. */
+@keyframes pr-icon-out {
+  to { opacity: 0; transform: rotate(-90deg) scale(0.5); }
+}
+@keyframes pr-icon-in {
+  from { opacity: 0; transform: rotate(90deg) scale(0.5); }
+}
+::view-transition-old(pr-theme-toggle) {
+  animation: 500ms cubic-bezier(0.16, 1, 0.3, 1) both pr-icon-out;
+}
+::view-transition-new(pr-theme-toggle) {
+  animation: 500ms cubic-bezier(0.16, 1, 0.3, 1) both pr-icon-in;
+}
+
+/* ============ Core dark overrides ============ */
+
+html[data-theme="dark"] {
+  color-scheme: dark;
+  background: var(--pr-dark-bg-color);
+  --tchart-bg-color: var(--pr-dark-bg-color);
+  --tchart-fade-color: var(--pr-dark-bg-color);
+}
+html[data-theme="dark"] body {
+  color: var(--pr-dark-text-primary);
+  background: var(--pr-dark-bg-color);
+  -webkit-font-smoothing: antialiased;
+  --bg-color: var(--pr-dark-bg-color);
+  --alt-bg-color: var(--pr-dark-surface);
+  --surface-color: var(--pr-dark-surface);
+  --photo-bg-color: var(--pr-dark-surface-hover);
+  --divider-color: var(--pr-dark-input-shadow);
+  --text-color: var(--pr-dark-text-primary);
+  --text-secondary-color: var(--pr-dark-text-secondary);
+  --text-muted-color: var(--pr-dark-text-secondary);
+  --link-color: var(--pr-dark-text-accent);
+  --link-bghover: rgba(76, 178, 255, .12);
+  --link-bgactive: rgba(76, 178, 255, .18);
+  --accent-color: var(--pr-dark-text-accent);
+  --accent-bghover: #5fbbff;
+  --accent-bgactive: #5fbbff;
+  --def-btn-color: #293440;
+  --input-border-color: var(--pr-dark-input-shadow);
+  --input-focus-color: var(--pr-dark-input-focus);
+  --danger-color: #ff5863;
+  --success-color: var(--pr-dark-success);
+  --warning-color: var(--pr-dark-warning);
+  --success-bg-color: rgba(91, 173, 87, .15);
+  --warning-bg-color: rgba(242, 140, 72, .15);
+  --danger-bg-color: rgba(239, 101, 143, .15);
+  --link-bg-color: rgba(76, 178, 255, .15);
+  --tooltip-bg-color: var(--pr-dark-surface-hover);
+  --fade-color: var(--pr-dark-surface);
+}
+html[data-theme="dark"] .pr-container {
+  background: var(--pr-dark-bg-color);
+}
+
+html[data-theme="dark"] .pr-theme-toggle--static:before {
+  background-image: url('/img/themeSun.webp');
+}
+html[data-theme="dark"] .pr-theme-toggle {
+  color: #c2cbd4;
+}
+
+/* ============ Header ============ */
+
+html[data-theme="dark"] .pr-header {
+  border-bottom: 1px solid var(--pr-dark-border);
+  background: var(--pr-dark-bg-color);
+}
+html[data-theme="dark"] .has-search-header .pr-header {
+  border-bottom: none;
+}
+html[data-theme="dark"] .pr-header-auth .pr-header-text:after {
+  background-color: var(--pr-dark-text-secondary);
+}
+
+/* ============ Dropdowns ============ */
+
+html[data-theme="dark"] .pr-dropdown-wrap span.dropdown-menu,
+html[data-theme="dark"] .dropdown-menu {
+  background: var(--pr-dark-surface);
+  border: 1px solid var(--pr-dark-border);
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
+}
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li > a.pr-dropdown-item:hover,
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li > a.pr-dropdown-item:focus,
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li > a.pr-dropdown-remove-item:hover,
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li > a.pr-dropdown-remove-item:focus {
+  background: var(--pr-dark-surface-hover);
+}
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li.selected > .pr-dropdown-item:after {
+  background-image: url('data:image/svg+xml,%3Csvg viewBox="0 0 15 12" width="15" height="12" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M 2 6 L 5.5 9.5 L 13 3" stroke="%23fff" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/%3E%3C/svg%3E');
+}
+html[data-theme="dark"] .pr-dropdown-wrap ul.dropdown-menu > li.divider,
+html[data-theme="dark"] .dropdown-menu .divider {
+  background: var(--pr-dark-border);
+}
+
+html[data-theme="dark"] .pr-sort-marker:before,
+html[data-theme="dark"] .pr-sort-marker:after {
+  background-image: url('data:image/svg+xml,%3Csvg%20height%3D%224%22%20viewBox%3D%220%200%207%204%22%20width%3D%227%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22m3.71%203.29%202.78-2.78c.12-.12.12-.3%200-.42-.06-.06-.13-.09-.21-.09h-5.56c-.16%200-.3.13-.3.3%200%20.08.04.16.09.21l2.78%202.78c.12.12.3.12.42%200z%22%20fill%3D%22%23fff%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E');
+}
+
+/* ============ Owner balance / auth photo ============ */
+
+html[data-theme="dark"] .pr-auth-photo img,
+html[data-theme="dark"] .pr-owner-balance-photo img,
+html[data-theme="dark"] .pr-dropdown-item-photo img,
+html[data-theme="dark"] .pr-popup-account-photo img {
+  background: var(--pr-dark-surface-hover);
+}
+
+/* ============ Buttons ============ */
+
+html[data-theme="dark"] .btn-primary {
+  background-color: var(--pr-dark-accent);
+  color: #fff;
+}
+html[data-theme="dark"] .btn-primary:hover,
+html[data-theme="dark"] .btn-primary:focus,
+html[data-theme="dark"] .btn-primary:active {
+  background-color: var(--pr-dark-accent-hover);
+}
+html[data-theme="dark"] .btn-default {
+  background-color: transparent;
+  color: var(--pr-dark-text-accent);
+}
+html[data-theme="dark"] .btn-default:hover,
+html[data-theme="dark"] .btn-default:focus,
+html[data-theme="dark"] .btn-default:active,
+html[data-theme="dark"] .open > .dropdown-toggle.btn-default {
+  color: var(--pr-dark-text-accent);
+  background-color: rgba(76, 178, 255, .12);
+  box-shadow: none;
+}
+html[data-theme="dark"] .btn-default.btn-danger {
+  color: var(--pr-dark-danger);
+  background-color: transparent;
+}
+html[data-theme="dark"] .btn-default.btn-danger:hover,
+html[data-theme="dark"] .btn-default.btn-danger:focus,
+html[data-theme="dark"] .btn-default.btn-danger:active {
+  color: var(--pr-dark-danger);
