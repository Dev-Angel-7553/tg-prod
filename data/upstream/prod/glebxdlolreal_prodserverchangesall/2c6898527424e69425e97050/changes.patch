+    Cafe.hideStatus();
+  },
+  showStatus: function(text) {
+    clearTimeout(Cafe.statusTo);
+    $('.js-status').text(text).addClass('shown');
+    if (!Cafe.isClosed) {
+      Cafe.statusTo = setTimeout(function(){ Cafe.hideStatus(); }, 2500);
+    }
+  },
+  hideStatus: function() {
+    clearTimeout(Cafe.statusTo);
+    $('.js-status').removeClass('shown');
+  },
