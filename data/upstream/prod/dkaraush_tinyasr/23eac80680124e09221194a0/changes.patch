+        let mut a: Vec<f32> = vec![127.0, -0.0, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 126.5, -126.5, 0.49999997, -0.49999997, 3.0, -127.0, 0.0, 64.5];
