+  to {
+    transform: translateX(calc(70% * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-emerge {
+  from {
+    transform: translateX(calc(70% * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-dim {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 0.1;
+  }
+}
+
+@keyframes fx-undim {
+  from {
+    opacity: 0.1;
+  }
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes fx-slide-in {
+  from {
+    transform: translateX(calc(100% * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-slide-out {
+  to {
+    transform: translateX(calc(100% * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-rise-in {
+  from {
+    opacity: 0;
+    transform: translateX(calc(48px * var(--dir, 1)));
+  }
+}
+
+@keyframes fx-rise-out {
+  to {
+    opacity: 0;
+    transform: translateX(calc(48px * var(--dir, 1)));
+  }
+}
+
+/* The screen under an Android transition stays put; the animation only ends with the other screen's. */
+@keyframes fx-hold {
+  to {
+    transform: none;
+  }
+}
