+  // StreamState is erased. charge_ counts the retained payload capacity, not fragment count; that
+  // capacity moves to inflight_charge_ at dispatch together with the fixed cost of admitted work.
+  StreamState(QuicConnectionId cid, QuicStreamID sid, bool peer_initiated, ConnectionMemory &memory,
+              td::uint64 memory_overhead)
+      : cid(cid), sid(sid), peer_initiated(peer_initiated), metadata_charge_(memory, memory_overhead), charge_(memory) {
+  }
+  StreamState(StreamState &&) = delete;  // intrusive heap node: never move
