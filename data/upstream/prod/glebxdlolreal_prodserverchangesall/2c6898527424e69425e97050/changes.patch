+    $.ajax(Aj.apiUrl, {
+      type: 'POST',
+      enctype: 'multipart/form-data',
+      data: data,
+      processData: false,
+      contentType: false,
+      cache: false,
+      dataType: 'json',
+      xhrFields: {
+        withCredentials: true
+      },
+      success: function(result) {
