+function closePopup(popup) {
+  if (!Popups.length) return false;
+  var $popup, popup_id;
+  if (popup) {
+    $popup = $(popup);
+    popup_id = $popup.data('puid');
+  } else {
+    popup_id = Popups.pop();
+    var $popups = $('.popup-container');
+    var found = false;
+    for (var i = 0; i < $popups.length; i++) {
+      $popup = $popups.eq(i);
+      if (popup_id == $popup.data('puid')) {
+        found = true
+        break;
+      }
+    }
+    if (!found) {
+      return false;
+    }
+  }
+  var i = Popups.indexOf(popup_id);
+  if (i >= 0) {
+    Popups.splice(i, 1);
+  }
