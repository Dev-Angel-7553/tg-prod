-<title>Telegram macOS</title>
-<description>• Bug fixes, minor improvements, and more.</description>
-<pubDate>2026-15-11 17:54:39</pubDate>
-<enclosure sparkle:version="283512" sparkle:shortVersionString="13.2.0" sparkle:dsaSignature="MCwCFGa0rrLQJXGFdobVFgmLwQY/0ZZAAhQdSIA2RLDIeGjflfP1JQzfZ8tOVA==" url="https://mac-updates.telegram.org/beta/Telegram-13.2.0.283512.app.zip" length="226742864" forbidden="false" critical="false" environment="beta" fileName="Telegram-13.2.0.283512.app.zip" internalUrl="https://t.me/macos_beta_updates_files/359" dmgName="Telegram-13.2.0.283512.dmg" type="application/octet-stream"/>
