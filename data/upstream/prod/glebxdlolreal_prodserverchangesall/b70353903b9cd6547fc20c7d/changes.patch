+
+/* Light (design.md §11.9). One light runs through a screen: the hero mark is its source, Best Value the second, the
+   in-page CTA the third, and the eye follows them in that order. Every glow is a box-shadow or a gradient painted
+   once; the sources breathe on one 8 s clock by the opacity of those layers alone, which the compositor animates.
+   src/fx/light.ts sets .neon-lit on a source near the screen while the page is visible and Telegram has the app
+   active, with --neon-delay, which puts it in phase; lit while none breathes, it starts the clock at the peak.
+   Unlit, under reduced motion and in snap mode, each keeps its still: the glow at the peak of its breath, so a breath
+   starts from it with no step. --glow-from and --glow-to are the tone's (tokens.css). */
+
+/* The aura (.neon-aura, src/fx/light.ts neonAura), for a screen's one primary card: a glow outside its rounded edge,
+   --glow-from on the start side and --glow-to on the end, which trade places every 8 s while the whole breathes. Each
+   halo is a tight glow on the contour over a wider one pulled in by its spread, so the light is spent within the 8 px
+   gap above and below. It lies on the page under every island and text and goes with its card: neonAura puts it in
+   the sheet over the card's box, or first in the card. The light takes the card's entrance and its inner glow layer
+   breathes, so neither animation replaces the other. Outer shadows only, so the ring stays crisp. */
+.neon-aura {
+  --island-shadow: var(--neon-contact);
+  position: relative;
+}
+
+.neon-aura__light,
+.neon-aura__glow,
+.neon-aura__glow::before,
+.neon-aura__glow::after {
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  pointer-events: none;
+}
+
+.neon-aura__light {
+  z-index: -1;
+}
+
+/* Out of the card, the light takes the card's radius (neonAura passes it). */
+.fx-sheet > .neon-aura__light {
+  inset: auto;
+  border-radius: var(--aura-radius);
+}
+
+/* The still: the halos where the breath's peak finds them, halfway through their tide (src/fx/light.ts TIDE), so a
+   breath meets it. */
+.neon-aura__glow::before,
+.neon-aura__glow::after {
+  content: '';
+  opacity: 0.65;
+}
+
+.neon-aura__glow::before {
+  box-shadow:
+    calc(-1 * var(--neon-lean)) 0 var(--neon-blur) var(--neon-spread) color-mix(in srgb, var(--glow-from) var(--neon-a), transparent),
+    0 0 calc(var(--neon-blur) / 2) color-mix(in srgb, var(--glow-from) var(--neon-core), transparent);
+}
+
+.neon-aura__glow::after {
+  box-shadow:
+    var(--neon-lean) 0 var(--neon-blur) var(--neon-spread) color-mix(in srgb, var(--glow-to) var(--neon-a), transparent),
+    0 0 calc(var(--neon-blur) / 2) color-mix(in srgb, var(--glow-to) var(--neon-core), transparent);
+}
+
+/* Best Value's light is its ring's gradient. */
+.plan-emphasis--strong {
+  --glow-to: var(--best-glow-to);
+}
+
+/* The aura's breath on its glow and its halos' tide (src/fx/light.ts BREATH, TIDE), lit like every source: with the
+   stage's light, 1 at the peak to 0.7 at the low, 4 s each way, eased. The halos trade places a quarter breath behind
+   it and half a breath apart, so their sum holds; at the peak each stands at its still, 0.65. --neon-delay, which
+   premiumbot-fx.js sets on the light, puts all three on the shared clock. */
+.neon-aura__light.neon-lit > .neon-aura__glow {
+  animation: pm-aura-breath 4s ease-in-out var(--neon-delay, 0s) infinite alternate;
+}
+
+.neon-aura__light.neon-lit > .neon-aura__glow::before {
+  animation: pm-aura-tide 4s ease-in-out calc(var(--neon-delay, 0s) - 2s) infinite alternate;
+}
+
+.neon-aura__light.neon-lit > .neon-aura__glow::after {
+  animation: pm-aura-tide 4s ease-in-out calc(var(--neon-delay, 0s) - 6s) infinite alternate;
+}
+
+@keyframes pm-aura-breath {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0.7;
+  }
+}
+
+@keyframes pm-aura-tide {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0.3;
+  }
+}
+
+.fx-reduce .neon-aura__glow,
+.fx-reduce .neon-aura__glow::before,
+.fx-reduce .neon-aura__glow::after {
+  animation: none;
+}
+
+/* The static glow (.neon-glow), for secondary islands: the aura's two halos at their core strength, without motion. */
+.neon-glow {
+  box-shadow:
+    var(--neon-contact),
+    calc(-1 * var(--neon-lean)) 0 var(--neon-blur) calc(var(--neon-spread) - 4px) color-mix(in srgb, var(--glow-from) var(--neon-core), transparent),
+    var(--neon-lean) 0 var(--neon-blur) calc(var(--neon-spread) - 4px) color-mix(in srgb, var(--glow-to) var(--neon-core), transparent);
+}
+
+/* Islands catch no light: the fill sets a cell apart, and the one lit edge is Best Value's ring. Where a black cell
+   is about the page's own colour, Android and desktop dark, a hairline draws its contour (.neon-rim for any other
+   surface): --rim-line, one colour all round, masked out
+   of a full layer between the border box and the padding box, so it takes no room and turns with the corners.
+   Everywhere else it is clear. */
+:is(.island, .neon-rim) {
+  position: relative;
+}
+
+:is(.island, .neon-rim):not(.plan-emphasis--strong)::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  padding: 1px;
+  border-radius: inherit;
+  background: var(--rim-line);
+  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor;
+  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
+  pointer-events: none;
+}
+
+/* The CTA's glow (src/ui/components/cta.ts), the third source: the pill's light on the page, the tone's two colours a
+   little under it, each leaning to its end, both of one size, so the light is even on both sides. Pulled in by its
+   spread, it starts inside the pill's edge and is spent about 20 px below it: no rim hugs the pill and no band shows.
+   The glow breathes by its own opacity (below); its
+   ::before fades it with an inactive pill. It lies in the pill's face, over the bar's grain. */
+.cta-glow {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  border-radius: inherit;
+}
+
+.cta-glow::before {
+  --cta-glow-a: 48%;
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  box-shadow:
+    -8px 8px 24px -12px color-mix(in srgb, var(--glow-from) var(--cta-glow-a), transparent),
+    8px 8px 24px -12px color-mix(in srgb, var(--glow-to) var(--cta-glow-a), transparent);
+  transition: opacity 200ms ease-out;
+}
+
+:root.theme-dark .cta-glow::before {
+  --cta-glow-a: 64%;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not(.theme-light) .cta-glow::before {
+    --cta-glow-a: 64%;
+  }
+}
+
+/* Before 16.2, as the bloom: full colour under a filter, so the glow's opacity is left to an inactive pill's fade. */
+@supports not (color: color-mix(in srgb, red, red)) {
+  .cta-glow::before {
+    box-shadow:
+      -8px 8px 24px -12px var(--glow-from),
+      8px 8px 24px -12px var(--glow-to);
+    filter: opacity(var(--cta-glow-a));
+  }
+}
+
+.cta-button--premium[aria-disabled='true'] .cta-glow::before {
+  opacity: 0;
+}
+
+/* The bar covers the field, so it carries the field's grain itself, under the pill and its glow, wherever its page
+   does (screens-subscription.css .cta-bar::before): the same eased rise, as a mask. */
+.cta-bar::after {
+  content: '';
+  position: absolute;
+  inset: calc(-1 * var(--space-24)) 0 0;
+  z-index: -1;
+  background:
+    url(../img/premiumbot/grain.png) 0 0 / 64px 64px,
+    url(../img/premiumbot/grain.png) 29px 13px / 61px 61px;
+  opacity: var(--light-grain-a);
+  image-rendering: pixelated;
+  -webkit-mask: linear-gradient(#0000, #00000008 5px, #0000001f 10px, #00000043 15px, #00000070 20px, #000000a0 25px, #000000ce 30px, #000000f1 35px, #000 40px);
+  mask: linear-gradient(#0000, #00000008 5px, #0000001f 10px, #00000043 15px, #00000070 20px, #000000a0 25px, #000000ce 30px, #000000f1 35px, #000 40px);
+  pointer-events: none;
+}
+
+/* The breath, shared: 4 s each way from the peak. The aura breathes the same on its glow, by Web Animations started on
+   the clock's origin, its halos trading places a quarter breath behind (src/fx/light.ts BREATH, TIDE), so a light shown
+   again stands in phase from its first frame, where a CSS animation would start over. */
+.cta-glow.neon-lit,
+.fx-stage.neon-lit::after,
+.fx-light.neon-lit > .fx-light__stage::after {
+  animation: neon-breath 4s ease-in-out var(--neon-delay, 0s) infinite alternate;
+}
+
+.fx-reduce .neon-lit,
+.fx-reduce .neon-lit::after {
+  animation: none;
+}
+
+@keyframes neon-breath {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0.7;
+  }
+}
+
+/* Carousel */
+.fx-carousel__track {
+  display: flex;
+  gap: 12px;
+  overflow-x: auto;
+  overscroll-behavior-x: contain;
+  scroll-snap-type: x mandatory;
+  scroll-padding-inline: var(--gutter, 16px);
+  padding: 4px var(--gutter, 16px) 8px;
+  scrollbar-width: none;
+}
+
+.fx-carousel__track::-webkit-scrollbar {
+  display: none;
+}
+
+.fx-carousel__track:focus-visible {
+  outline: 2px solid var(--tg-theme-link-color, #2481cc);
+  outline-offset: -2px;
+  border-radius: 16px;
+}
+
+:where(.fx-carousel__track) > * {
+  flex: 0 0 auto;
+  width: min(82%, 340px);
+  scroll-snap-align: center;
+  scroll-snap-stop: always;
+}
+
+.fx-carousel__dots {
+  display: flex;
+  justify-content: center;
+  gap: 8px;
+  padding: 4px 0;
+  color: var(--tg-theme-hint-color, #999);
+}
+
+.fx-carousel__dots > i {
+  width: 8px;
+  height: 8px;
+  border-radius: 4px;
+  background: currentColor;
+  opacity: 0.3;
+  transition:
+    width 300ms ease-out,
+    opacity 300ms ease-out;
+}
+
+.fx-carousel__dots > .is-on {
+  width: 24px;
+  opacity: 0.9;
+}
+
+/* Push and pop as each platform navigates, over the light field, which stays where it is
+   (src/fx/field.ts). The pages paint no page of their own, so the one under a moving page shows only where that one
+   is not; src/ui/shell.ts keeps an outgoing screen fixed in place. iOS, macOS and desktop: the new screen slides over
+   the old one, which recedes 30 % into a 10 % dim, 320 ms on a critically damped curve
+   (NavigationTransitionCoordinator.swift). The old screen's box, which clips it, travels with the new one's edge, and
+   its content 70 % of the way back, which nets the 30 %. Android: the new screen comes 48 dp in and fades up over the
+   old one, which holds still and fades out under it, 150 ms (ActionBarLayout.java). Pop is the reverse of each. */
+@media (prefers-reduced-motion: no-preference) {
+  .screen {
+    --fx-push: 320ms;
+    --fx-push-ease: cubic-bezier(0.25, 1, 0.5, 1);
+  }
+
+  html.platform-android .screen {
+    --fx-push: 150ms;
+    --fx-push-ease: cubic-bezier(0.33, 1, 0.68, 1);
+  }
+
+  .screen.is-entering-push,
+  .screen.is-leaving-pop {
+    z-index: 1;
+    box-shadow: calc(-3px * var(--dir, 1)) 0 12px rgb(0 0 0 / 0.04);
+  }
+
+  .screen.is-entering-push {
+    position: relative;
+    animation: fx-slide-in var(--fx-push) var(--fx-push-ease) both;
+  }
+
+  .screen.is-leaving-pop {
+    animation: fx-slide-out var(--fx-push) var(--fx-push-ease) both;
+  }
+
+  /* Its box, and with it the dim, reaches up under the safe areas #app pads for (base.css), where the light field runs
+     on, so in fullscreen the dim has no top edge; the padding keeps the content where it was. */
+  .screen.is-leaving-push,
+  .screen.is-entering-pop {
+    --fx-under: calc(var(--tg-safe-area-inset-top, 0px) + var(--tg-content-safe-area-inset-top, 0px));
+    overflow: hidden;
+    margin-top: calc(-1 * var(--fx-under));
+    padding-top: calc(var(--space-16) + var(--fx-under));
+  }
+
+  .screen.is-leaving-push {
+    animation: fx-tuck var(--fx-push) var(--fx-push-ease) both;
+  }
+
+  .screen.is-entering-pop {
