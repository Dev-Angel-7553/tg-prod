+@keyframes fx-cta-drift {
+  from {
+    transform: translateX(-20.83%);
+  }
+  to {
+    transform: translateX(-55.83%);
+  }
+}
+
+/* One sweep from 200 ms after the peak, as Best Value's light leaves its sparkle (premiumbot-fx.js GLINT.start), 410 ms:
