+
+/* Floating toggle button (top-right, above header). */
+.pr-theme-toggle {
+  align-items: center;
+  background: transparent;
+  border: 0;
+  color: #8a939d;
+  cursor: pointer;
+  display: flex;
+  height: 50px;
+  justify-content: center;
+  opacity: 0.7;
+  padding: 0 16px;
+  position: fixed;
+  right: 77px;
+  top: 0;
+  transition: opacity 0.15s ease;
+  view-transition-name: pr-theme-toggle;
+  z-index: 1001;
+}
+.pr-theme-toggle:hover {
+  opacity: 1;
+}
+.pr-theme-toggle canvas,
+.pr-theme-toggle--static:before {
+  display: block;
+  height: 22px;
+  width: 22px;
+}
+.pr-theme-toggle--static canvas {
+  display: none;
+}
+.pr-theme-toggle--static:before {
+  content: '';
+  background-size: contain;
+  background-image: url('/img/themeMoon.webp');
+}
+@media (min-width: 768px) {
+  .pr-theme-toggle {
+    right: 0;
+  }
+}
+
+html.pr-theme-switching body,
+html.pr-theme-switching body * {
+  transition: none !important;
+}
+
+::view-transition-group(root) {
+  isolation: isolate;
+  overflow: hidden;
+}
+::view-transition-image-pair(root) {
+  isolation: auto;
+  overflow: hidden;
+}
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+::view-transition-old(root) {
+  z-index: 9999;
+  will-change: clip-path;
+  transform: translateZ(0);
+}
+::view-transition-new(root) { z-index: 1; }
+
+:root.pr-theme-reveal::view-transition-old(root) {
+  z-index: 9999;
+  transform: none;
+  will-change: auto;
+  -webkit-mask-image: radial-gradient(
+    circle at var(--pr-theme-origin-x) var(--pr-theme-origin-y),
+    transparent 0,
+    transparent var(--pr-theme-hole-radius),
+    #000 calc(var(--pr-theme-hole-radius) + 1px)
+  );
+  mask-image: radial-gradient(
+    circle at var(--pr-theme-origin-x) var(--pr-theme-origin-y),
+    transparent 0,
+    transparent var(--pr-theme-hole-radius),
+    #000 calc(var(--pr-theme-hole-radius) + 1px)
