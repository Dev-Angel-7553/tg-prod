+.fx-reduce .cta-button.cta-button--premium.is-lit .cta-glow::after,
+.fx-reduce .cta-button.cta-button--premium.is-lit .cta-skin::before,
+.fx-reduce .cta-button.cta-button--premium.is-lit .cta-skin::after,
