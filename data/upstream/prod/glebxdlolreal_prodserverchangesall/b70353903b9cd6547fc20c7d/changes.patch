+@keyframes skeleton-breathe {
+  to {
+    opacity: 0.6;
+  }
+}
+
+/* A 12 px bar centred in a 20 px line, so a skeleton row is as tall as the row it stands for. */
+.skeleton-line {
+  height: 12px;
+  margin-block: var(--space-4);
+  border-radius: 6px;
+}
+
+.skeleton-circle {
+  border-radius: 50%;
+}
+
+.skeleton-hero {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: var(--space-8) var(--gutter) var(--space-32);
+}
+
+.skeleton-hero .skeleton-circle {
+  margin-bottom: var(--space-16);
+}
+
+.skeleton-hero .skeleton-title {
