@@ -0,0 +1,969 @@
+:root {
+  --bt-dark-bg: #1A2026;
+  --bt-dark-card-bg: #212A33;
+  --bt-dark-card-bg-hover: #293440;
+  --bt-dark-text-primary: #fff;
+  --bt-dark-text-secondary: #8794A1;
+  --bt-dark-text-accent: #4CB2FF;
+  --bt-dark-accent: #2392e7;
+  --bt-dark-accent-hover: #0b9dec;
+  --bt-dark-border: #293440;
+  --bt-dark-danger: #ef658f;
+  --bt-dark-warning: #f28c48;
+  --bt-dark-success: #5bad57;
+}
+
+@property --bt-theme-hole-radius {
+  /* Percentages avoid zoom-scaled pixel interpolation. */
+  syntax: '<percentage>';
+  inherits: false;
+  initial-value: 0%;
+}
+
+.bt-theme-toggle {
+  align-items: center;
+  background: transparent;
+  border: 0;
+  color: #8794a1;
+  cursor: pointer;
+  display: inline-flex;
+  justify-content: center;
+  opacity: 0.7;
+  padding: 0 8px;
+  transition: opacity 0.15s ease;
+  vertical-align: top;
+  view-transition-name: bt-theme-toggle;
+}
+.bt-theme-toggle:hover {
+  opacity: 1;
+}
+.bt-theme-toggle canvas,
+.bt-theme-toggle--static:before {
+  display: block;
+  height: 22px;
+  width: 22px;
+}
+.bt-theme-toggle--static canvas {
+  display: none;
+}
+.bt-theme-toggle--static:before {
+  content: '';
+  background-size: contain;
+  background-image: url('/img/themeMoon.webp');
+}
+
+html.bt-theme-switching body,
+html.bt-theme-switching body * {
+  transition: none !important;
+}
+
+::view-transition-group(root) {
+  isolation: isolate;
+  overflow: hidden;
+}
+::view-transition-image-pair(root) {
+  isolation: auto;
+  overflow: hidden;
+}
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+::view-transition-old(root) {
+  z-index: 9999; /* the shrinking layer rides on top */
+  will-change: clip-path;
+  transform: translateZ(0); /* dedicated, fully-rasterised GPU layer */
+}
+::view-transition-new(root) { z-index: 1; }
+
+/* Light -> dark also keeps the old snapshot on top, but opens an expanding
+   transparent hole in it. This avoids repeatedly clipping Chromium's live
+   new(root) snapshot, which can retain a stale compositor surface. */
+:root.bt-theme-reveal::view-transition-old(root) {
+  z-index: 9999;
+  transform: none;
+  will-change: auto;
+  -webkit-mask-image: radial-gradient(
+    circle at var(--bt-theme-origin-x) var(--bt-theme-origin-y),
+    transparent 0,
+    transparent var(--bt-theme-hole-radius),
+    #000 calc(var(--bt-theme-hole-radius) + 1px)
+  );
+  mask-image: radial-gradient(
+    circle at var(--bt-theme-origin-x) var(--bt-theme-origin-y),
+    transparent 0,
+    transparent var(--bt-theme-hole-radius),
+    #000 calc(var(--bt-theme-hole-radius) + 1px)
+  );
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+  mask-mode: alpha;
+}
+:root.bt-theme-reveal::view-transition-new(root) { z-index: 1; }
+
+/* Shrink the dark snapshot into the toggle. */
+:root.bt-theme-collapse::view-transition-old(root) {
+  z-index: 9999;
+  transform: none;
+  will-change: auto;
+  -webkit-mask-image: radial-gradient(
+    circle at var(--bt-theme-origin-x) var(--bt-theme-origin-y),
+    #000 0,
+    #000 var(--bt-theme-hole-radius),
+    transparent calc(var(--bt-theme-hole-radius) + 1px)
+  );
+  mask-image: radial-gradient(
+    circle at var(--bt-theme-origin-x) var(--bt-theme-origin-y),
+    #000 0,
+    #000 var(--bt-theme-hole-radius),
+    transparent calc(var(--bt-theme-hole-radius) + 1px)
+  );
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+  mask-mode: alpha;
+}
+:root.bt-theme-collapse::view-transition-new(root) { z-index: 1; }
+
+/* Theme toggle icon morph animation. */
+@keyframes bt-icon-out {
+  to { opacity: 0; transform: rotate(-90deg) scale(0.5); }
+}
+@keyframes bt-icon-in {
+  from { opacity: 0; transform: rotate(90deg) scale(0.5); }
+}
+::view-transition-old(bt-theme-toggle) {
+  animation: 500ms cubic-bezier(0.16, 1, 0.3, 1) both bt-icon-out;
+}
+::view-transition-new(bt-theme-toggle) {
+  animation: 500ms cubic-bezier(0.16, 1, 0.3, 1) both bt-icon-in;
+}
+
+html.bt-theme-dark {
+  color-scheme: dark;
+  background: var(--bt-dark-bg);
+}
+html.bt-theme-dark body {
+  color: var(--bt-dark-text-primary);
+  background: var(--bt-dark-bg);
+  -webkit-font-smoothing: antialiased;
+}
+html.bt-theme-dark .bt-container {
+  background: var(--bt-dark-bg);
+}
+html.bt-theme-dark a,
+html.bt-theme-dark a:hover,
+html.bt-theme-dark a:focus {
+  color: var(--bt-dark-text-accent);
+}
+
+html.bt-theme-dark .bt-theme-toggle--static:before {
+  background-image: url('/img/themeSun.webp');
+}
+html.bt-theme-dark .bt-theme-toggle {
+  color: #4cb2ff;
