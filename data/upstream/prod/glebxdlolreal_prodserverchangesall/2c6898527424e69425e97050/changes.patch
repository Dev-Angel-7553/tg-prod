+      seconds: 3600,
+      formatter: function(d) { return self.formatTime(d) }
+    }, {
+      name: '15 minute',
+      seconds: 60 * 15,
+      formatter: function(d) { return self.formatTime(d) }
+    }, {
+      name: 'minute',
+      seconds: 60,
+      formatter: function(d) { return d.getUTCMinutes() + 'm' }
+    }, {
+      name: '15 second',
+      seconds: 15,
+      formatter: function(d) { return d.getUTCSeconds() + 's' }
+    }, {
+      name: 'second',
+      seconds: 1,
+      formatter: function(d) { return d.getUTCSeconds() + 's' }
+    }, {
+      name: 'decisecond',
+      seconds: 1/10,
+      formatter: function(d) { return d.getUTCMilliseconds() + 'ms' }
+    }, {
+      name: 'centisecond',
+      seconds: 1/100,
