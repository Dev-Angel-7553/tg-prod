+        assert!(a.len() >= m * k && init.len() >= jp1 * 8 && q.w.len() >= jp1 * pb && q.s.len() >= jp1 * ng * 8 && (m == 0 || o.len() >= (m - 1) * stride + (jp1 - jp0) * 8));
