+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal; /* kill the UA plus-lighter edge seam */
+  backface-visibility: hidden;
+  contain: paint;
+}
+::view-transition-old(root) {
+  z-index: 9999; /* the shrinking layer rides on top */
+  will-change: clip-path;
+  transform: translateZ(0); /* dedicated, fully-rasterised GPU layer */
+}
+::view-transition-new(root) { z-index: 1; }
+
